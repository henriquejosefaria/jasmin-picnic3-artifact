#[returnaddress="stack"]
fn _HCP_base(
  #[poly=chalenge_h] reg ptr u8[CH_FULL_SIZE] challenge_h,
  #[poly=treeCv]     reg ptr u8[PNC_DIGEST_SIZE] treeCv,
  #[poly=salt]       reg ptr u8[PNC_SALT_SIZE] salt,
  #[poly=pubKey]     reg ptr u8[PNC_INPUT_SIZE] pubKey,
  #[poly=plaintext]  reg ptr u8[PNC_INPUT_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message,
