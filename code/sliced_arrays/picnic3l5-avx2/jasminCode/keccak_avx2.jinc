require "params.jinc"
require "keccak/keccak1600_updstate.jinc"

namespace A1 {
  param int _ASIZE = 1;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A2 {
  param int _ASIZE = 2;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A13 {
  param int _ASIZE = PNC_MESSAGE_BYTE_LENGTH;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A32 {
  param int _ASIZE = PNC_SALT_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A64 {
  param int _ASIZE = PNC_SALT_AND_ROOT_LENGTH;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A128 {
  param int _ASIZE = TAPE_AUX_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A1024 {
  param int _ASIZE = COMMITMENTS_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A2048 {
  param int _ASIZE = MSGS_FULL_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A38464 {
  param int _ASIZE = PNC_N_ROUNDS * CH_ROUND_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}


/**************************/
/*     HASH FUNCTIONS     */
/**************************/

#[returnaddress="stack"]
fn _computeSaltAndRootSeed(
  #[secret]          reg ptr u8[PNC_SALT_AND_ROOT_LENGTH] out,
  #[poly=privateKey] reg ptr u8[MZD_SIZE] privateKey,
  #[poly=publickey]  reg ptr u8[MZD_SIZE] publicKey,
  #[poly=plaintext]  reg ptr u8[MZD_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message
) -> reg ptr u8[PNC_SALT_AND_ROOT_LENGTH]
{
  
  reg ui64 len;
  reg u16 t16;
  reg ui8 x;
  reg u8 y;

  stack u8[2] t16_s;

  reg ptr u8[2] t16_r;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, privateKey, publicKey, plaintext, message);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  t16 = LOWMC_N_BITS;
  t16_s[:u16 0] = t16;

  len = 32;
  () = #unspill(privateKey);
  pst = A32::_update_updstate_avx2(pst, privateKey, len);
  len = 13;
  () = #unspill(message);
  pst = A13::_update_updstate_avx2(pst,    message, len);
  len = 32;
  () = #unspill(publicKey);
  pst = A32::_update_updstate_avx2(pst,  publicKey, len);
  len = 32;
  () = #unspill(plaintext);
  pst = A32::_update_updstate_avx2(pst,  plaintext, len);
  len = 2;
  t16_r = t16_s;
  pst = A2::_update_updstate_avx2(pst,  t16_r, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  _, out = A64::_squeeze_updstate_avx2(pst, out, len);

  return out;
}

/*
 * Hash one seed with a salt, the round index and the node index
 * to compute two new seeds.
 */
#[returnaddress="stack"]
fn _hashSeed(
  #[secret]         reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] out,
  #[poly=inputSeed] reg ptr u8[PNC_SEED_SIZE] seed,
  #[poly=salt]      reg ptr u8[PNC_SALT_SIZE] salt,
  #[poly=repIndex]  reg u16 repIndex, 
  #[poly=nodeIndex] reg u16 nodeIndex
) -> reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  stack u8[1] prefix_s;
  stack u8[2] t16_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16;
  reg ptr u8[2 * PNC_SEED_SIZE] reg_out;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out);
  () = #spill(seed);
  () = #spill(salt);
  () = #spill(repIndex);
  () = #spill(nodeIndex);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;

  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  prefix_s[0] = HASH_PREFIX_1;
  prefix = prefix_s;
  len = 1;
  pst = A1::_update_updstate_avx2(pst, prefix, len);

  len = 32;
  () = #unspill(seed);
  pst = A32::_update_updstate_avx2(pst, seed, len);

  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(repIndex);
  t16_s[:u16 0] = repIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  
  len = 2;
  () = #unspill(nodeIndex);
  t16_s[:u16 0] = nodeIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  reg_out = out[0:2 * PNC_SEED_SIZE];
  _, reg_out = A64::_squeeze_updstate_avx2(pst, reg_out, len);
  out[0:2 * PNC_SEED_SIZE] = reg_out;

  return out;
}

#[returnaddress="stack"]
fn base_commit(
  #[secret] reg ptr u64[26] pst,
  #[secret] reg ptr u8[TREE_DATA_SIZE] seed,
  #[secret] reg ptr u8[TAPE_AUX_SIZE] tape_aux, 
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg ptr u64[26]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 round16;

  stack u8[2] t16_s;

  reg ptr u8[2] t16;

  () = #spill(seed, tape_aux, salt, round, player);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 32;
  () = #unspill(seed);
  pst = A32::_update_updstate_avx2(pst, seed, len);

  () = #unspill(player);
  if(player == (PNC_N_MPC_PARTIES - 1))
  {
    len = 128;
    () = #unspill(tape_aux);
    pst = A128::_update_updstate_avx2(pst, tape_aux, len);
  }

  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(round);
  round16 = round;
  t16_s[:u16 0] = round16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  
  len = 2;
  () = #unspill(player);
  t16_s[:u16 0] = player;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  return pst;
}

/*
 * Hash one seed with a salt, the round index and the player index
 * to compute one commit (times 4).
 */
#[returnaddress="stack"]
fn _commit(
  #[secret] reg ptr u8[COMMITMENT_SIZE] out,
  #[secret] reg ptr u8[TREE_DATA_SIZE] seed,
  #[secret] reg ptr u8[TAPE_AUX_SIZE] tape_aux, 
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENT_SIZE]
{
  reg ui64 len;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;
  
  () = #spill(out);
  pst = s_pst;
  pst = base_commit(pst, seed, tape_aux, salt, round, player);
  
  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  _, out = A64::_squeeze_updstate_avx2(pst, out, len);

  return out;
}

#[returnaddress="stack"]
fn _commit_assemble(
  #[public] reg u64 out,
  #[secret] reg ptr u8[TREE_DATA_SIZE] seed,
  #[secret] reg ptr u8[TAPE_AUX_SIZE] tape_aux, 
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg u64
{
  reg ui64 len outi;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () =#spill(out);
  pst = s_pst;
  pst = base_commit(pst, seed, tape_aux, salt, round, player);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  outi = (64ui)out;
  outi, _ = _squeeze_m_updstate_avx2(outi, len, pst);
  out = (64u)outi;

  return out;
}

#[returnaddress="stack"]
fn _commit_h(
  #[secret] reg ptr u8[CH_ROUND_SIZE] out,
  #[secret] reg ptr u8[COMMITMENTS_SIZE] in
) -> reg ptr u8[CH_ROUND_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 1024;
  pst = A1024::_update_updstate_avx2(pst, in, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  _, out = A64::_squeeze_updstate_avx2(pst, out, len);

  return out;
}

#[returnaddress="stack"]
fn _commit_v(
  #[secret] reg ptr u8[CV_ROUND_SIZE] out,
  #[secret] reg ptr u8[MZD_SIZE] inputs,
  #[secret] reg const ptr u8[MSGS_FULL_SIZE] msgs
) -> reg ptr u8[CV_ROUND_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, inputs, msgs);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  y = SHAKE;
  x = (R136 >> 3);
  pst = s_pst;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 32;
  () = #unspill(inputs);
  pst = A32::_update_updstate_avx2(pst, inputs, len);
  len = 2048;
  () = #unspill(msgs);
  pst = A2048::_update_updstate_avx2(pst, msgs, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 64;
  () = #unspill(out);
  _, out = A64::_squeeze_updstate_avx2(pst, out, len);

  return out;
}

#[returnaddress="stack"]
fn _computeParentHash(
  #[secret] reg ptr u8[TREE_NODES_3_SIZE] tree,
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_have,
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_exists,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 parent,
  #[public] reg u16 parent_u16
) -> reg ptr u8[TREE_NODES_3_SIZE], reg ptr u8[TREE_NUM_NODES_3], reg ptr u8[TREE_NUM_NODES_3]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 t8 y;
  reg u64 child_idx offset;

  stack u8[1] prefix_s;
  stack u8[2] t16_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16;

  reg ptr u8[64] seed;
  reg ptr u8[PNC_DIGEST_SIZE] parent_node;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(tree, tree_have, tree_exists, salt, parent, parent_u16);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  prefix_s[0] = HASH_PREFIX_3;
  prefix = prefix_s;
  len = 1;
  pst = A1::_update_updstate_avx2(pst, prefix, len);

  () = #unspill(tree, parent);
  child_idx = parent;
  child_idx <<= 1;
  child_idx *= PNC_DIGEST_SIZE;
  child_idx += PNC_DIGEST_SIZE;

  seed = tree[child_idx:64];

  len = 64;
  pst = A64::_update_updstate_avx2(pst, seed, len);

  () = #unspill(parent);
  child_idx = parent;
  child_idx <<= 1;
  child_idx += 2;
  t8 = 0;
  if(child_idx < TREE_NUM_NODES_3)
  {

    () = #unspill(tree, parent, tree_exists);
    t8 = tree_exists[parent];
    if(t8 == 1)
    {
      child_idx *= PNC_DIGEST_SIZE;
      seed = tree[child_idx:64];

      len = 64;
      pst = A64::_update_updstate_avx2(pst, seed, len);
    }
  }

  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(parent_u16);
  t16_s[:u16 0] =  parent_u16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  () = #unspill(parent);
  () = #unspill(tree_have);
  tree_have[parent] = 1;

  parent *= PNC_DIGEST_SIZE;

  len = 64;
  offset = 0;
  parent_node = tree[parent:PNC_DIGEST_SIZE];
  _, parent_node = A64::_squeeze_updstate_avx2(pst, parent_node, len);
  tree[parent:PNC_DIGEST_SIZE] = parent_node;

  return tree, tree_have, tree_exists;
}

fn __get_u16(
  #[poly=array] reg ptr u8[PNC_DIGEST_SIZE] array,
  #[public]     reg u64 bits
) -> reg u16
{
  reg u64 byte;
  reg u16 chosen_byte;

  // t = array[bitNumber / 8];

  byte = bits;
  byte >>= 3;
  chosen_byte = array.[:u16 byte];


  // t1 = (7 - (bitNumber % 8)));

  byte = bits;
  byte &= 7;
  bits = 7;
  bits -= byte;


  // t >>= t1;

  while(bits > 0)
  {chosen_byte >>= 1; bits -= 1;}

  // t &= 0x01;

  chosen_byte &= 0x01;

  return chosen_byte;
}

fn _bitsToChunks(
  #[public]      reg u64 chunkLenBits,
  #[poly=chunks] reg ptr u8[PNC_DIGEST_SIZE] input,
  #[poly=chunks] reg ptr u16[CHUNKS_SIZE] chunks
) -> reg u64, reg ptr u16[CHUNKS_SIZE]
{

  reg u16 t16;
  reg u64 i j z t chunkCount;

  if(chunkLenBits > PNC_DIGEST_SIZE * 8)
  {
    chunkCount = 0;
  } 
  else
  {
    chunkCount = (PNC_DIGEST_SIZE * 8);
    chunkCount = chunkCount / chunkLenBits;

    i = 0;
    while(i < chunkCount){
      chunks[i] = 0;
      j = 0;
      while(j < chunkLenBits)
      {
        t = chunkLenBits;
        t *= i;
        t += j;
        t >>= 3;

        t = chunkLenBits;
        t *= i;
        t += j;

        t16 = __get_u16(input, t);

        z = j;
        while(z > 0){t16 <<= 1; z -= 1;}

        t16 += chunks[i];

        chunks[i] = t16;
        j += 1;
      }

      i += 1;
    }
  }

  return chunkCount, chunks;
}

inline fn __bitsToChunks(
  #[public]      reg u64 chunkLenBits,
  #[poly=chunks] stack u8[PNC_DIGEST_SIZE] input,
  #[poly=chunks] stack u16[CHUNKS_SIZE] chunks
) -> reg u64, stack u16[CHUNKS_SIZE]
{
  reg u64 chunkCount;
  reg ptr u8[PNC_DIGEST_SIZE] a;
  reg ptr u16[CHUNKS_SIZE] b;
  
  a = input;
  b = chunks;
  chunkCount, b = _bitsToChunks(chunkLenBits, a, b);
  chunks = b;

  return chunkCount, chunks;
}

/*
 * This function generates challenge values that are public (challengeC and challengeP) 
 *  as such, their values may use #[declassify]
 */
fn __appendUnique(
  #[public]          reg u16 value,
  #[public]          reg u64 position,
  #[public] reg ptr u8[CHALLENGE_C_SIZE] challengeC
) -> reg u64, reg ptr u8[CHALLENGE_C_SIZE]
{
  reg u16 t;
  reg u64 i tmp64;

  if(position == 0)
  {
    tmp64 = position;
    challengeC[:u16 tmp64] = value;
    position += 1;
  }
  else
  {
    i = 0;
    while(i < position)
    {
      tmp64 = i;
      /* It is a public value - will be within the signature */
      t = challengeC[:u16 tmp64];

      if(t == value){
        i = position;
      }
      i += 1;
    }
    if(i == position){
      tmp64 = position;
      challengeC[:u16 tmp64] = value;
      position += 1;
    }
  }

  return position, challengeC;
}

fn _expand_challenge(
  #[public] reg u64 signature,
  #[public] reg ptr u8[SIG_CHALLENGE_C_SIZE] challengeC,
  #[public] reg ptr u8[SIG_CHALLENGE_P_SIZE] challengeP
) -> reg ptr u8[SIG_CHALLENGE_C_SIZE], reg ptr u8[SIG_CHALLENGE_P_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 t16;
  reg u64 i t64 countC countP;
  reg u64 numChunks bitsPerChunk tmp64;

  stack u64 s_countC s_countP s_bitsPerChunk;

  stack u8[1] prefix_s;
  stack u8[PNC_DIGEST_SIZE] h;
  stack u16[CHUNKS_SIZE] chunks;

  stack ptr u8[SIG_CHALLENGE_C_SIZE] s_challengeC;
  stack ptr u8[SIG_CHALLENGE_P_SIZE] s_challengeP;

  reg ptr u8[1] prefix;
  reg ptr u8[PNC_DIGEST_SIZE] reg_h;

  inline int z;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  for z=0 to PNC_U64_DIGEST_SIZE
  {
    i = [signature + z*8];
    h[:u64 z] = i;
  }
  s_challengeC = challengeC;
  s_challengeP = challengeP;

  // Populate C
  // NOTE:  THE ORIGINAL USES U32 WORDS, HERE WERE USING U64 SO
  // THE OPERATION 32 - clz(x - 1) WAS SHIFTED TO 64 - clz(x - 1)

  countC = 0;
  while(countC < CHUNKS_SIZE)
  {
    chunks[countC] = 0;

    countC += 1;
  }

  // bitsPerChunkC
  bitsPerChunk = PNC_N_ROUNDS;
  _, _, _, _, bitsPerChunk = #DEC(bitsPerChunk);
  _, _, _, _, _, bitsPerChunk = #LZCNT_64(bitsPerChunk);
  t64 = bitsPerChunk;
  bitsPerChunk = 64;
  bitsPerChunk -= t64;
  s_bitsPerChunk = bitsPerChunk;

  // ORIGINAL
  countC = 0;
  while(countC < PNC_N_OPENED_ROUNDS)
  {
    bitsPerChunk = s_bitsPerChunk;
    numChunks, chunks = __bitsToChunks(bitsPerChunk, h, chunks);

    i = 0;
    while(i < numChunks)
    {
      /* It is a public value within the signature */
      #[declassify] t16 = chunks[i];
      if(t16 < PNC_N_ROUNDS)
      {
        challengeC = s_challengeC;
        countC, challengeC = 
          __appendUnique(t16, countC, challengeC);
        s_challengeC = challengeC;
        
      }
      if(countC == PNC_N_OPENED_ROUNDS)
      {
        i = numChunks;
      }

      i += 1;
    }
    s_countC = countC;

    /*****************************/
    /*         SET STATE         */
    /*****************************/

    pst = s_pst;
    x = (R136 >> 3);
    y = SHAKE;
    pst = _init_updstate_avx2(pst, x, y);

    /*****************************/
    /*     ABSORB INTO STATE     */
    /*****************************/
    len = 1;
    prefix_s[:u8 0] = HASH_PREFIX_1;
    prefix = prefix_s;
    pst = A1::_update_updstate_avx2(pst, prefix, len);
    len = 64;
    reg_h = h;
    pst = A64::_update_updstate_avx2(pst, reg_h, len);
    pst = _finish_updstate_avx2(pst);

    len = 64;
    reg_h = h;
    pst, reg_h = A64::_squeeze_updstate_avx2(pst, reg_h, len);
    s_pst = pst;
    h = reg_h;

    countC = s_countC;
  }

  // Note that we always compute h = H(h) after setting C
  
  // bitsPerChunkP
  bitsPerChunk = PNC_N_MPC_PARTIES;
  _, _, _, _, bitsPerChunk = #DEC(bitsPerChunk);
  _, _, _, _, _, bitsPerChunk = #LZCNT_64(bitsPerChunk);
  t64 = bitsPerChunk;
  bitsPerChunk = 64;
  bitsPerChunk -= t64;
  s_bitsPerChunk = bitsPerChunk;

  countP = 0;
  while(countP < PNC_N_OPENED_ROUNDS)
  {
    bitsPerChunk = s_bitsPerChunk;
    numChunks, chunks = __bitsToChunks(bitsPerChunk, h, chunks);

    i = 0;
    while(i < numChunks)
    {
      /* It is a public value within the signature */
      #[declassify] t16 = chunks[i];
      
      if(t16 < PNC_N_MPC_PARTIES)
      {
        tmp64 = countP;
        challengeP = s_challengeP;
        challengeP[:u16 tmp64] = t16;
        s_challengeP = challengeP;
        countP += 1;
      }
      if(countP == PNC_N_OPENED_ROUNDS)
      {
        i = numChunks;
      }

      i += 1;
    }
    s_countP = countP;

    if(countP < PNC_N_OPENED_ROUNDS)
    {
      /*****************************/
      /*         SET STATE         */
      /*****************************/

      pst = s_pst;
      x = (R136 >> 3);
      y = SHAKE;
      pst = _init_updstate_avx2(pst, x, y);

      /*****************************/
      /*     ABSORB INTO STATE     */
      /*****************************/
      
      prefix_s[:u8 0] = HASH_PREFIX_1;
      len = 1;
      prefix = prefix_s;
      pst = A1::_update_updstate_avx2(pst, prefix, len);
      len = 64;
      reg_h = h;
      pst = A64::_update_updstate_avx2(pst, reg_h, len);
      pst = _finish_updstate_avx2(pst);

      len = 64;
      reg_h = h;
      pst, reg_h = A64::_squeeze_updstate_avx2(pst, reg_h, len);
      s_pst = pst;
      h = reg_h;
    }
    countP = s_countP;
  }

  challengeC = s_challengeC;
  challengeP = s_challengeP;
  return challengeC, challengeP;
}

inline
fn __expand_challenge(
  #[public] reg u64 sig,
  #[public] stack u8[SIG_CHALLENGE_C_SIZE] challengeC,
  #[public] stack u8[SIG_CHALLENGE_P_SIZE] challengeP
) -> stack u8[SIG_CHALLENGE_C_SIZE], stack u8[SIG_CHALLENGE_P_SIZE]
{

  reg ptr u8[CHALLENGE_C_SIZE] reg_challengeC;
  reg ptr u8[CHALLENGE_P_SIZE] reg_challengeP;

  reg_challengeC = challengeC;
  reg_challengeP = challengeP;
  reg_challengeC, reg_challengeP = _expand_challenge(sig, reg_challengeC, reg_challengeP);
  challengeC = reg_challengeC;
  challengeP = reg_challengeP;

  return challengeC, challengeP;
}
