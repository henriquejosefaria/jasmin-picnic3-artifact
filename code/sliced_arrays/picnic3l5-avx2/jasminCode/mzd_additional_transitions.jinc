	return r_block_j;
}

inline fn __mzd_xor_uint64_block_v4(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[ROUND_CONSTANT_SIZE] s_block_j,
	inline int idx
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j[idx * MZD_SIZE: MZD_SIZE]; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

inline fn __mzd_and_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
