require "mzd_additional.jinc"

inline fn __mzd_copy_uint64_256(
	#[poly=y] stack u8[MZD_SIZE] x,
	#[poly=y] stack u8[MZD_SIZE] y
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a b;

	a = x;
	b = y;
	a = _mzd_copy_uint64_256(a,b);
	x = a;
	
	return x;
}

inline fn __mzd_copy_uint64_256_v1(
	#[poly=y] reg ptr u8[MZD_SIZE] x,
	#[poly=y] stack u8[MZD_SIZE] y
) -> reg ptr u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a;

	a = y;
	x = _mzd_copy_uint64_256(x,a);
	
	return x;
}

inline fn __mzd_copy_uint64_256_v2(
	#[poly=y] stack u8[MZD_SIZE] x,
	#[poly=y] reg ptr u8[MZD_SIZE] y
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a;

	a = x;
	a = _mzd_copy_uint64_256(a,y);
	x = a;
	
	return x;
}

inline fn __mzd_xor_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

inline fn __mzd_xor_uint64_block_v2(
	#[poly=r_block_j] reg ptr u8[MZD_SIZE] r_block_j, 
	#[poly=f_block_j] stack u8[MZD_SIZE] f_block_j, 
	#[poly=s_block_j] stack u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

inline fn __mzd_xor_uint64_block_v3(
	#[poly=r_block_j] stack u8[MZD_SIZE] r_block_j, 
	#[poly=f_block_j] stack u8[MZD_SIZE] f_block_j, 
	#[poly=s_block_j] reg ptr u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

