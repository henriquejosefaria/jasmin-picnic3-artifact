}

inline fn __mzd_mul_v_uint64_256(
	#[secret] stack u8[MZD_SIZE] c_block,
	#[secret] stack u8[MZD_SIZE] vptr,
	#[secret] stack u64[MATRIX_ROUND] k_matrix_
) -> stack u8[MZD_SIZE]
{
	reg u256 t;

	reg ptr u8[MZD_SIZE] a b;
	reg ptr u64[MATRIX_ROUND] c;

	a = c_block;
	b = vptr;
	c = k_matrix_;

	t = #set0_256();
	a[:u256 0] = t;

	a = _mzd_addmul_v_uint64_256(a,b,c);

	c_block = a;

	return c_block;
}

inline fn __mzd_mul_v_uint64_256_v2(
	#[secret] stack u8[MZD_SIZE] c_block,
	#[secret] stack u8[MZD_SIZE] vptr,
	#[secret] stack u64[MATRIX_ROUND*4] k_matrix_,
	inline int idx
) -> stack u8[MZD_SIZE]
{
	reg u256 t;

	reg ptr u8[MZD_SIZE] a b;
	reg ptr u64[MATRIX_ROUND] c;

	a = c_block;
	b = vptr;
	c = k_matrix_[idx*MATRIX_ROUND: MATRIX_ROUND];

	t = #set0_256();
	a[:u256 0] = t;

	a = _mzd_addmul_v_uint64_256(a,b,c);

	c_block = a;

	return c_block;
}

