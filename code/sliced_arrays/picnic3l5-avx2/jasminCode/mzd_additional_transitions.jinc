inline fn __mzd_addmul_v_uint64_256(
	#[secret] stack u8[MZD_SIZE] c_block vptr,
	#[secret] reg ptr u64[MATRIX_ROUND] a_block
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a b;
	
	a = c_block;
	b = vptr;

	a = _mzd_addmul_v_uint64_256(a, b, a_block);

	c_block = a;

	return c_block;
}

inline fn __mzd_addmul_v_uint64_256_v2(
	stack u8[MZD_SIZE] c_block,
	reg ptr u8[MZD_SIZE] vptr,
	reg ptr u64[MATRIX_ROUND] a_block
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a;
	
	a = c_block;

	a = _mzd_addmul_v_uint64_256(a,vptr,a_block);
	c_block = a;

	return c_block;
}

inline fn __mzd_addmul_v_uint64_256_v3(
	stack u8[MZD_SIZE] c_block vptr,
	stack u64[MATRIX_ROUND*5] a_block,
	inline int idx
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a b;
	reg ptr u64[MATRIX_ROUND] c;

	a = c_block;
	b = vptr;
	c = a_block[idx * MATRIX_ROUND: MATRIX_ROUND];

	a = _mzd_addmul_v_uint64_256(a, b, c);
	c_block = a;

	return c_block;
}

