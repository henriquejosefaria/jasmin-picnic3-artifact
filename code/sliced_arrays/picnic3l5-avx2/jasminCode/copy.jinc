

#[returnaddress="stack"]
fn _memcpy_4Words_from_reg(
	reg ptr u8[PNC_INPUT_SIZE] out,
	#[public]   reg u64 in
) -> reg ptr u8[PNC_INPUT_SIZE]
{

	reg u256 t;
	t = [:u256 in + 0];
	out[:u256 0] = t;

	return out;	
}

inline
fn __memcpy_4Words_from_reg(
	#[secret] stack u8[PNC_INPUT_SIZE] out,
	#[public] reg u64 in
) -> stack u8[PNC_INPUT_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;

	a = out;
	a = _memcpy_4Words_from_reg(a, in);
	out = a;

	return out;
}

#[returnaddress="stack"]
fn _memcpy_4SecretWords_from_reg(
	#[secret] reg ptr u8[PNC_INPUT_SIZE] out,
	reg u64 in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u256 t;

	t = [:u256 in + 0];
	out[:u256 0] = t;

	return out;	
}

inline 
fn __memcpy_4SecretWords_from_reg(
	#[secret] stack u8[PNC_INPUT_SIZE] out,
	reg u64 in
) -> stack u8[PNC_INPUT_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;

	a = out;
	a = _memcpy_4Words_from_reg(a, in);
	out = a;

	return out;
}

#[returnaddress="stack"]
fn _memcpy_8Words_from_reg(
	reg ptr u8[SIG_CHALLENGE_SIZE] out,
	#[public]   reg u64 in
) -> reg ptr u8[SIG_CHALLENGE_SIZE]
{
	reg u256 t;

	t = [:u256 in + 0];
	out[:u256 0] = t;

	t = [:u256 in + 32];
	out[:u256 1] = t;

	return out;	
}

inline fn __memcpy_8Words_from_reg(
	#[secret] stack u8[SIG_CHALLENGE_SIZE] out,
	#[public] reg u64 in
) -> stack u8[SIG_CHALLENGE_SIZE]
{
	reg ptr u8[SIG_CHALLENGE_SIZE] a;

	a = out;
	a = _memcpy_8Words_from_reg(a, in);
	out = a;

	return out;
}

#[returnaddress="stack"]
fn _memcpy_4Words(
	#[poly=in] reg ptr u8[PNC_INPUT_SIZE] out,
	#[poly=in] reg ptr u8[PNC_INPUT_SIZE] in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u256 t;

	t = in.[:u256 0];
	out.[:u256 0] = t;

	return out;	
}

inline 
fn __memcpy_4Words(
	#[poly=in] stack u8[TREE_NODES_1_SIZE] out,
	#[poly=in] stack u8[PNC_ROOT_SIZE] in
) -> stack u8[TREE_NODES_1_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;
	reg ptr u8[PNC_INPUT_SIZE] b;

	a = out[0:PNC_INPUT_SIZE];
	b = in[0:PNC_INPUT_SIZE];

	a = _memcpy_4Words(a,b);
	out[0:PNC_INPUT_SIZE] = a;

	return out;
}


inline 
fn __reg_to_stack_uint64_256(
  #[poly=b] reg ptr u8[MZD_SIZE] a,
  #[poly=b] stack u8[MZD_SIZE] b
) -> stack u8[MZD_SIZE]
{
  b = _memcpy_4Words(b, a);

  return b;
}
/*
inline 
fn __stack_to_reg_uint64_256(
  reg ptr u8[MZD_SIZE] a,
  stack u8[MZD_SIZE] b
) -> reg ptr u8[MZD_SIZE]
{
  reg ptr u8[MZD_SIZE] c;

  c = b;
  a = _memcpy_4Words(a, c);
 
  return a;
}
*/

inline fn __memcpy_mzd_array(
	#[poly=in] stack u8[MZD_SIZE] out,
	#[poly=in] stack u8[MZD_SIZE] in
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a b;

	a = out;
	b = in;
	a = _memcpy_4Words(a,b);
	out = a; 

	return out;
}

inline
fn __memcpy_message(
	#[secret] stack u8[PNC_MESSAGE_BYTE_LENGTH] out,
	#[public] reg u64 in
) -> stack u8[PNC_MESSAGE_BYTE_LENGTH]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while( i < PNC_MESSAGE_BYTE_LENGTH)
	{
		t8 = [:u8 in + i];
		out[i] = t8;
		i += 1;
	}

	return out;	
}

#[returnaddress="stack"]
fn _memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_SALT_SIZE] in
) -> reg u64
{

	reg u256 t;
	t = in.[:u256 0];
	[:u256 out + 0] = t;
	out += PNC_SALT_SIZE;

	return out;
}

inline fn __memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] stack u8[PNC_SALT_AND_ROOT_LENGTH] in
) -> reg u64
{
	reg ptr u8[PNC_SALT_SIZE] a;

	a = in[0:PNC_SALT_SIZE];
 	out = _memcpy_salt(out,a);

 	return out;
}

inline
fn _memcpy_salt_from_sig(
	#[poly=in] stack u8[PNC_SALT_SIZE] out,
	#[public]  reg u64 in
) -> stack u8[PNC_SALT_SIZE], reg u64
{
	reg u256 t;
	
	t = [:u256 in + 0];
	out.[:u256 0] = t;

	in += PNC_SALT_SIZE;

	return out, in;
}

inline fn __memcpy_salt_from_sig(
	#[poly=in] stack u8[PNC_SALT_SIZE] out,
	#[public]  reg u64 in
) -> stack u8[PNC_SALT_SIZE], reg u64
{
	reg ptr u8[PNC_SALT_SIZE] a;

	a = out;
 	a, in = _memcpy_salt_from_sig(a, in);
 	out = a;

 	return out, in;
}

inline
fn __copy_seed_from_proofs(
	stack u8[TREE_NODES_2_SIZE] tree, 
	stack u8[SIG_PROOFS_SIZE] proofs, 
	reg u64 tree_idx,
	reg u64 proofs_idx
) -> stack u8[TREE_NODES_2_SIZE], reg u64
{
	reg u64 i t;

	i = 0;
	while(i < PNC_U64_SEED_SIZE)
	{	
		t = proofs[:u64 proofs_idx];
		tree[:u64 tree_idx] = t;

		proofs_idx += 1;
		tree_idx += 1;
		i += 1;
	}

	return tree, proofs_idx;
}
