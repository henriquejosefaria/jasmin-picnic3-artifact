inline
fn __copy4Words_to_iSeedsTree(
	reg ptr u8[FULL_TREE_SIZE_1] tree, 
	reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	reg u64 idx_1, 
	reg u64 idx_2
) -> reg ptr u8[FULL_TREE_SIZE_1]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{t = tmp.[:u64 idx_2 + z * 8]; tree.[:u64 idx_1 + z * 8] = t;}

	return tree;
}

inline
fn __copy4Words_1(
	#[poly=tmp] reg ptr u8[TREE_NODES_1_SIZE] tree, 
	#[poly=tmp] reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	#[public]   reg u64 idx_1, 
	#[public]   reg u64 idx_2
) -> reg ptr u8[TREE_NODES_1_SIZE]
{
	reg u256 t;

	t = tmp.[:u256 idx_2];
	tree.[:u256 idx_1] = t;

	return tree;
}


inline fn __copy4Words_2(
	#[poly=tmp] reg ptr u8[TREE_NODES_2_SIZE] tree, 
	#[poly=tmp] stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	#[public]   reg u64 idx_1, 
	#[public]   reg u64 idx_2
) -> reg ptr u8[TREE_NODES_2_SIZE]
{
	reg u256 t;

	t = tmp.[:u256 idx_2];
	tree.[:u256 idx_1] = t;

	return tree;
}

inline fn __copy4Words_22(
	#[poly=tmp] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] tree, 
	#[poly=tmp] stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	#[public]   reg u64 idx_1, 
	#[public]   reg u64 idx_2
) -> reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_INPUT_SIZE
	{t = tmp.[:u64 idx_2 + z * 8]; tree.[:u64 idx_1 + z*8] = t;}

	return tree;
}

#[returnaddress="stack"]
fn __copy_digest(
	reg ptr u8[PNC_DIGEST_SIZE] dst,
	reg ptr u8[PNC_DIGEST_SIZE] src
) -> reg ptr u8[PNC_DIGEST_SIZE]
{
	reg u8 t;
	reg u64 i;

	i = 0;

	while(i < PNC_DIGEST_SIZE)
	{
		t = src[i];
		dst[ i] = t;

		i += 1;
	}

	return dst;
}

#[returnaddress="stack"]
fn __copy_digest_from_tree_v2(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[TREE_NODES_3_SIZE] in,
	#[public]  reg u64 in_pos
) -> reg u64
{
	reg u64 t i;

	i = 0;
	while(i < PNC_U64_DIGEST_SIZE)
	{
		t = in.[:u64 in_pos];
		[out + 0] = t;

		in_pos += 8;
		out += 8;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_digest_from_tree_v1(
	reg ptr u8[SIG_CV_INFO_SIZE] out,
	reg ptr u8[FULL_TREE_SIZE_3] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_CV_INFO_SIZE]
{
	reg u64 t;

	t = in.[:u64 in_pos];
	out.[:u64 out_pos] = t;

	t = in.[:u64 in_pos + 8];
	out.[:u64 out_pos + 8] = t;

	t = in.[:u64 in_pos + 16];
	out.[:u64 out_pos + 16] = t;

	t = in.[:u64 in_pos + 24];
	out.[:u64 out_pos + 24] = t;

	t = in.[:u64 in_pos + 32];
	out.[:u64 out_pos + 32] = t;

	t = in.[:u64 in_pos + 40];
	out.[:u64 out_pos + 40] = t;

	t = in.[:u64 in_pos + 48];
	out.[:u64 out_pos + 48] = t;

	t = in.[:u64 in_pos + 56];
	out.[:u64 out_pos + 56] = t;

	return out;
}


#[returnaddress="stack"]
fn __copy_digest_from_tree(
	reg ptr u8[SIG_CV_INFO_SIZE] out,
	reg ptr u8[TREE_NODES_3_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_CV_INFO_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_DIGEST_SIZE
	{
		t = in.[:u64 in_pos + z * 8];
		out.[:u64 out_pos + z * 8] = t;
	}

	return out;
}


#[returnaddress="stack"]
fn __copy_seed_to_iSeed(
	reg ptr u8[SIG_I_SEED_INFO_SIZE] out,
	reg ptr	u8[TREE_NODES_1_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_I_SEED_INFO_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in.[:u64 in_pos + z + 8];
		out.[:u64 out_pos + z * 8] = t;
	}
	
	return out;
}

#[returnaddress="stack"]
fn __copy_seed_to_sig(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[TREE_NODES_1_SIZE] in,
	#[public]  reg u64 in_pos
) -> reg u64
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in.[:u64 in_pos];
		[out + 0] = t;

		in_pos += 8;
		out += 8;
	}
	
	return out;
}

#[returnadress="stack"]
fn __copy_seed_from_iSeed(
	reg ptr u8[TREE_NODES_2_SIZE] out,
	reg ptr	u8[TREE_NODES_1_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[TREE_NODES_2_SIZE]
{
	reg u8 t8;

	inline int z;

	for z=0 to TREE_DATA_SIZE
	{
		t8 = in[in_pos + z];
		out[out_pos + z] = t8;
	}
	
	return out;
}

#[returnaddress="stack"]
fn __copy_seed_from_SeedInfo_v1(
	reg ptr u8[FULL_TREE_SIZE_1] out,
	reg ptr	u8[SIG_I_SEED_INFO_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[FULL_TREE_SIZE_1]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in.[:u64 in_pos + z * 8];
		out.[:u64 out_pos + z * 8] = t;
	}
	
	return out;
}

#[returnaddress="stack"]
fn __copy_seed_from_sig(
	reg ptr u8[TREE_NODES_1_SIZE] out,
	reg u64 in,
	reg u64 out_pos
) -> reg ptr u8[TREE_NODES_1_SIZE], reg u64
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = [in + 0];
		out[:u64 out_pos + z] = t;
	
		in += 8;
	}
	
	return out, in;
}

#[returnaddress="stack"]
#[returnadress="stack"]
fn __copy_seed_from_SeedInfo_2(
	reg ptr u8[FULL_TREE_SIZE_2] out,
	reg ptr	u8[PROOF_SEED_INFO_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[FULL_TREE_SIZE_2]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in.[:u64 in_pos + z * 8];
