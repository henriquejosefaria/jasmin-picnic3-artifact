#[returnaddress="stack"]
fn __copy_seed_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr	u8[FULL_TREE_SIZE_2] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t;

	inline int z;

	for z=0 to PNC_SEED_SIZE
	{
		t = in[in_pos];
		out[out_pos] = t;

		in_pos += 1;
		out_pos += 1;
	}
	
	return out;
}

#[returnaddress="stack"]
fn __copy_seed_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[TREE_NODES_2_SIZE] in,
	#[public]  reg u64 in_pos
) -> reg u64
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in[:u64 in_pos + z];
		[out + 0] = t;
		out += 8;
	}
	
	return out;
}

#[returnaddress="stack"]
fn __copy_tape_aux_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) ->reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t8;
	
	inline int z;

	for z=0 to PNC_VIEW_SIZE
	{

		t8 = in[in_idx];
		out[out_idx] = t8;

		out_idx += 1;
		in_idx += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_tape_aux_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] in,
	#[public]  reg u64 in_idx
) ->reg u64
{
	reg u64 t;
	
	inline int z;

	for z=0 to PNC_U64_VIEW_SIZE
	{

		t = in.[:u64 in_idx + z*8];
		[out + 0] = t;
		out += 8;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_input_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr u8[PNC_N_ROUNDS * PNC_INPUT_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) -> reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while(i < PNC_INPUT_SIZE)
	{

		t8 = in[in_idx];
		out[out_idx] = t8;

		out_idx += 1;
		in_idx += 1;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_input_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] in,
	#[public]  reg u64 in_idx
) -> reg u64
{
	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_INPUT_SIZE)
	{

		t64 = in.[:u64 in_idx];
		[out + 0] = t64;

		out += 8;
		in_idx += 8;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_msgs_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
