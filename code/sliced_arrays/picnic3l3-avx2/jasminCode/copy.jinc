

inline fn __reg_to_stack_uint64_192(
  #[poly=b] reg ptr u8[MZD_SIZE] a,
  #[poly=b] stack u8[MZD_SIZE] b
) -> stack u8[MZD_SIZE]
{
  reg u256 t;

	t = a.[:u256 0];
	b.[:u256 0] = t;

  return b;
}

inline fn __stack_to_reg_uint64_192(
  reg ptr u8[MZD_SIZE] a,
  stack u8[MZD_SIZE] b
) -> reg ptr u8[MZD_SIZE]
{
	reg u256 t;

	t = b[:u256 0];
	a[:u256 0] = t;

  return a;
}

#[returnaddress="stack"]
fn _WordsWords_from_reg(
	 reg ptr u8[PNC_INPUT_SIZE] out,
	    reg u64 in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u64 i t64;

	i = 0;
	while( i < PNC_U64_INPUT_SIZE)
	{
		t64 = [in + i * 8];
		out[:u64 i] = t64;
		i += 1;
	}

	return out;	
}

#[returnaddress="stack"]
fn _memcpy_3Words_from_reg(
	 reg ptr u8[PNC_INPUT_SIZE] out,
	 #[public]   reg u64 in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u64 i t64;

	i = 0;
	while( i < PNC_U64_INPUT_SIZE)
	{
		t64 = [in + i * 8];
		out[:u64 i] = t64;
		i += 1;
	}

	return out;	
}

inline fn __memcpy_3Words_from_reg(
	#[secret] stack u8[PNC_INPUT_SIZE] out,
	#[public] reg u64 in
) -> stack u8[PNC_INPUT_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;

	a = out;
	a = _memcpy_3Words_from_reg(a, in);
	out = a;

	return out;
}

