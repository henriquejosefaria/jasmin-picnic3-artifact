#[returnaddress="stack"]
fn _memcpy_3Words(
	#[poly=in] reg ptr u8[PNC_INPUT_SIZE] out,
	#[poly=in] reg ptr u8[PNC_INPUT_SIZE] in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u64 i t64;

	i = 0;
	while( i < PNC_INPUT_SIZE)
	{
		t64 = in.[:u64 i];
		out.[:u64 i] = t64;
		i += 8;
	}

	return out;	
}

inline fn __memcpy_3Words(
	#[poly=in] stack u8[TREE_NODES_1_SIZE] out,
	#[poly=in] stack u8[PNC_ROOT_SIZE] in
) -> stack u8[TREE_NODES_1_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;
	reg ptr u8[PNC_INPUT_SIZE] b;

	a = out[0:PNC_INPUT_SIZE];
	b = in[0:PNC_INPUT_SIZE];

	a = _memcpy_3Words(a,b);
	out[0:PNC_INPUT_SIZE] = a;

	return out;
}

#[returnaddress="stack"]
fn __memcpy_24bytes(
	reg ptr u8[PNC_INPUT_SIZE] out,
	reg ptr u8[PNC_INPUT_SIZE] in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while( i < PNC_INPUT_SIZE)
	{
		t8 = in[i];
		out[i] = t8;
		i += 1;
	}

	return out;	
}


#[returnaddress="stack"]
fn _memcpy_mzd_array(
	 reg ptr u8[MZD_SIZE] out,
	 reg ptr u8[MZD_SIZE] in
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 i t64;

	i = 0;
	while( i < PNC_U64_INPUT_SIZE)
	{
		t64 = in[:u64 i];
		out[:u64 i] = t64;
		i += 1;
	}

	return out;	
}

inline fn __memcpy_mzd_array(
	#[poly=in] stack u8[MZD_SIZE] out,
	#[poly=in] stack u8[MZD_SIZE] in
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a b;

	a = out;
	b = in;
	a = _memcpy_mzd_array(a,b);
	out = a; 

	return out;
}

inline
fn __memcpy_message(
	#[secret] stack u8[PNC_MESSAGE_BYTE_LENGTH] out,
	#[public] reg u64 in
) -> stack u8[PNC_MESSAGE_BYTE_LENGTH]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while( i < PNC_MESSAGE_BYTE_LENGTH)
	{
		t8 = [:u8 in + i];
		out[i] = t8;
		i += 1;
	}

	return out;	
}

#[returnaddress="stack"]
fn _memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_SALT_SIZE] in
) -> reg u64
{

	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_SALT_SIZE)
	{
		t64 = in[:u64 i];
		[out + 0] = t64;
		out += 8;
		i += 1;
	}

	return out;
}

inline fn __memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] stack u8[PNC_SALT_AND_ROOT_LENGTH] in
) -> reg u64
{
	reg ptr u8[PNC_SALT_SIZE] a;

	a = in[0: PNC_SALT_SIZE];
 	out = _memcpy_salt(out,a);

 	return out;
}

inline
fn _memcpy_salt_from_sig(
	#[poly=in] stack u8[PNC_SALT_SIZE] out,
	#[public]  reg u64 in
) -> stack u8[PNC_SALT_SIZE], reg u64
{

	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_SALT_SIZE)
	{
		t64 = [in + 0];
		out[:u64 i] = t64;
		in += 8;
		i += 1;
	}

	return out, in;
}

inline
fn __copy_seed_from_proofs(
	stack u8[TREE_NODES_2_SIZE] tree, 
	stack u8[SIG_PROOFS_SIZE] proofs, 
	reg u64 tree_idx,
	reg u64 proofs_idx
) -> stack u8[TREE_NODES_2_SIZE], reg u64
{
	reg u64 i t;

	i = 0;
	while(i < PNC_U64_SEED_SIZE)
	{	
		t = proofs[:u64 proofs_idx];
		tree.[:u64 tree_idx] = t;

		proofs_idx += 1;
		tree_idx += 8;
		i += 1;
	}

	return tree, proofs_idx;
}

#[returnaddress="stack"]
fn _memcpy_seedInfo(
	reg ptr u8[PROOF_SEED_INFO_SIZE] seedInfo, 
	reg ptr u8[SIG_PROOFS_SIZE] signature, 
	reg u64 idx
) -> reg ptr u8[PROOF_SEED_INFO_SIZE]
{
	reg u8 t8;
	reg u64 i sig_idx;

	sig_idx = idx;
	sig_idx *= PROOF_FULL_SIZE;

	i = 0;
	while(i < PROOF_SEED_INFO_SIZE)
	{	
		t8 = signature[sig_idx + PROOF_SEED_INFO_IDX];
		seedInfo[i] = t8;

		sig_idx += 1;
		i += 1;
	}

	return seedInfo;
}

inline
fn __copy3Words_1_v1(
	reg ptr u8[FULL_TREE_SIZE_1] tree, 
	reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	reg u64 idx_1, 
	reg u64 idx_2
) -> reg ptr u8[FULL_TREE_SIZE_1]
{
	reg u64 t;

	inline int z;

	for z=0 to 3
	{t = tmp.[:u64 idx_2 + z * 8]; tree.[:u64 idx_1 + z * 8] = t;}

	return tree;
}


inline
fn __copy3Words_1(
	#[poly=tmp] reg ptr u8[TREE_NODES_1_SIZE] tree,
	#[poly=tmp] reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp,
	#[public]   reg u64 idx_1,
	#[public]   reg u64 idx_2
) -> reg ptr u8[TREE_NODES_1_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to 3
	{t = tmp.[:u64 idx_2 + z * 8]; tree.[:u64 idx_1 + z * 8] = t;}

	return tree;
}



inline fn __copy3Words_2_v1(
	reg ptr u8[FULL_TREE_SIZE_2] tree, 
	stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	reg u64 idx_1, 
	reg u64 idx_2
) -> reg ptr u8[FULL_TREE_SIZE_2]
{
	reg u8 t;

	inline int z;

	for z=0 to PNC_INPUT_SIZE
	{t = tmp.[idx_2 + z]; tree.[idx_1 + z] = t;}

	return tree;
}

inline fn __copy3Words_2(
	#[poly=tmp] reg ptr u8[TREE_NODES_2_SIZE] tree,
	#[poly=tmp] stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp,
	#[public]   reg u64 idx_1,
	#[public]   reg u64 idx_2
) -> reg ptr u8[TREE_NODES_2_SIZE]
{
	reg u8 t;

	inline int z;

	for z=0 to PNC_INPUT_SIZE
	{t = tmp.[idx_2 + z]; tree.[idx_1 + z] = t;}

	return tree;
}

inline fn __copy3Words_22(
	#[poly=tmp] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] tree,
	#[poly=tmp] stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp,
	#[public]   reg u64 idx_1,
	#[public]   reg u64 idx_2
) -> reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_INPUT_SIZE
	{t = tmp.[:u64 idx_2 + z * 8]; tree.[:u64 idx_1 + z*8] = t;}

	return tree;
}

#[returnaddress="stack"]
fn __copy_digest(
	reg ptr u8[PNC_DIGEST_SIZE] dst,
	reg ptr u8[PNC_DIGEST_SIZE] src
) -> reg ptr u8[PNC_DIGEST_SIZE]
{
	reg u8 t;
	reg u64 i;

	i = 0;

	while(i < PNC_DIGEST_SIZE)
	{
		t = src[i];
		dst[ i] = t;

		i += 1;
	}

	return dst;
}

#[returnaddress="stack"]
fn __copy_digest_from_tree_v2(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[TREE_NODES_3_SIZE] in,
	#[public]  reg u64 in_pos
) -> reg u64
{
	reg u64 t i;

	i = 0;
	while(i < PNC_U64_DIGEST_SIZE)
	{
		t = in.[:u64 in_pos];
		[out + 0] = t;

		in_pos += 8;
		out += 8;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_digest_from_tree_v1(
	reg ptr u8[SIG_CV_INFO_SIZE] out,
	reg ptr u8[FULL_TREE_SIZE_3] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_CV_INFO_SIZE]
{
	reg u64 t;

	t = in.[:u64 in_pos];
	out.[:u64 out_pos] = t;

	t = in.[:u64 in_pos + 8];
	out.[:u64 out_pos + 8] = t;

	t = in.[:u64 in_pos + 16];
	out.[:u64 out_pos + 16] = t;

	t = in.[:u64 in_pos + 24];
	out.[:u64 out_pos + 24] = t;

	t = in.[:u64 in_pos + 32];
	out.[:u64 out_pos + 32] = t;

	t = in.[:u64 in_pos + 40];
	out.[:u64 out_pos + 40] = t;

	return out;
}


#[returnaddress="stack"]
fn __copy_digest_from_tree(
	reg ptr u8[SIG_CV_INFO_SIZE] out,
	reg ptr u8[TREE_NODES_3_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_CV_INFO_SIZE]
{
	reg u64 t;

	t = in.[:u64 in_pos];
	out.[:u64 out_pos] = t;

	t = in.[:u64 in_pos + 8];
	out.[:u64 out_pos + 8] = t;

	t = in.[:u64 in_pos + 16];
	out.[:u64 out_pos + 16] = t;

	t = in.[:u64 in_pos + 24];
	out.[:u64 out_pos + 24] = t;

	t = in.[:u64 in_pos + 32];
	out.[:u64 out_pos + 32] = t;

	t = in.[:u64 in_pos + 40];
	out.[:u64 out_pos + 40] = t;

	return out;
}


#[returnaddress="stack"]
fn __copy_seed_to_iSeed(
	reg ptr u8[SIG_I_SEED_INFO_SIZE] out,
	reg ptr	u8[TREE_NODES_1_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[SIG_I_SEED_INFO_SIZE]
{
	reg u64 t;

	t = in.[:u64 in_pos];
	out.[:u64 out_pos] = t;

	t = in.[:u64 in_pos + 8];
	out.[:u64 out_pos + 8] = t;

	t = in.[:u64 in_pos + 16];
	out.[:u64 out_pos + 16] = t;
	
	return out;
}

#[returnaddress="stack"]
fn __copy_seed_to_sig(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[TREE_NODES_1_SIZE] in,
	#[public]  reg u64 in_pos
) -> reg u64
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = in.[:u64 in_pos];
		[out + 0] = t;

		in_pos += 8;
		out += 8;
	}
	
	return out;
}

