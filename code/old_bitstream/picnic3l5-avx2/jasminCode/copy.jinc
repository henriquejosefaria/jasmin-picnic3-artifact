	idx = tapes_aux_idx;
	while(t < TAPE_AUX_SIZE)
	{
		x = tapes[ idx];
		tapes_aux[ t] = x;

		idx = idx + 1;
		t = t + 1;
	}

	return tapes_aux;
}

