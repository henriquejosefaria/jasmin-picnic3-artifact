
inline fn __reg_to_stack_uint64_256(
  #[poly=b] reg ptr u8[MZD_SIZE] a,
  #[poly=b] stack u8[MZD_SIZE] b
) -> stack u8[MZD_SIZE]
{
  reg u64 t;

  inline int i;

  for i=0 to MZD_U64_SIZE
  {
  	t = a[u64 i];
  	b[u64 i] = t;
  }
  
  return b;
}


inline fn __stack_to_reg_uint64_256(
  reg ptr u8[MZD_SIZE] a,
  stack u8[MZD_SIZE] b
) -> reg ptr u8[MZD_SIZE]
{
  reg u64 t;

  t = b[u64 0];
  a[u64 0] = t;

  t = b[u64 1];
  a[u64 1] = t;

  t = b[u64 2];
  a[u64 2] = t;

  t = b[u64 3];
  a[u64 3] = t;

  return a;
}
