#[returnaddress="stack"]
fn __copy_tape_aux_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) ->reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t8;
	
	inline int z;

	for z=0 to PNC_VIEW_SIZE
	{

		t8 = in[in_idx + z];
		out[out_idx + z] = t8;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_tape_aux_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] in,
	#[public]  reg u64 in_idx
) ->reg u64
{
	reg u64 t;
	
	inline int z;

	for z=0 to PNC_U64_VIEW_SIZE
	{

		t = in.[u64 in_idx + z*8];
		[out + 0] = t;
		out += 8;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_input_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr u8[PNC_N_ROUNDS * PNC_INPUT_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) -> reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while(i < PNC_INPUT_SIZE)
	{

		t8 = in[in_idx];
		out[out_idx] = t8;

		out_idx += 1;
		in_idx += 1;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_input_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_N_ROUNDS * PNC_INPUT_SIZE] in,
	#[public]  reg u64 in_idx
) -> reg u64
{
	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_INPUT_SIZE)
	{

		t64 = in.[u64 in_idx];
		[out + 0] = t64;

		out += 8;
		in_idx += 8;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_msgs_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) -> reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while(i < PNC_VIEW_SIZE)
	{

		t8 = in[in_idx];
		out[out_idx] = t8;

		out_idx += 1;
		in_idx += 1;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn __copy_msgs_to_proof(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] in,
	#[public]  reg u64 in_idx
) -> reg u64
{
	reg u64 i t;

	i = 0;
	while(i < PNC_U64_VIEW_SIZE)
	{

		t = in.[u64 in_idx];
		[out + 0] = t;

		in_idx += 8;
		out += 8;
		i += 1;
	}

	return out;
}

#[returnaddress="stack"]
fn _copy_unnopened_party_commit(
	reg ptr u8[COMMITMENTS_FULL_SIZE] out,
	reg ptr u8[SIG_PROOFS_SIZE] in,
	reg 	u64 out_idx,
	reg 	u64 in_idx
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while(i < PNC_DIGEST_SIZE)
	{

		t8 = in[in_idx];
		out[out_idx] = t8;

		out_idx += 1;
		in_idx += 1;
		i += 1;
	}

	return out;	
}

inline
fn __copy_unnopened_party_commit(
	stack u8[COMMITMENTS_FULL_SIZE] out,
	stack u8[SIG_PROOFS_SIZE] in,
	reg   u64 out_idx,
	reg   u64 in_idx
) -> stack u8[COMMITMENTS_FULL_SIZE]
{
	reg ptr u8[COMMITMENTS_FULL_SIZE] a;
	reg ptr u8[SIG_PROOFS_SIZE] b;

	a = out;
	b = in;
	a = _copy_unnopened_party_commit(a, b, out_idx, in_idx);
	out = a;

	return out;
}

