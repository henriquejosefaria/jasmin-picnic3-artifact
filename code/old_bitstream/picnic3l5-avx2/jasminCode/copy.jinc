inline
fn __memcpy_message(
	#[secret] stack u8[PNC_MESSAGE_BYTE_LENGTH] out,
	#[public] reg u64 in
) -> stack u8[PNC_MESSAGE_BYTE_LENGTH]
{
	reg u8 t8;
	reg u64 i;

	i = 0;
	while( i < PNC_MESSAGE_BYTE_LENGTH)
	{
		t8 = [:u8 in + i];
		out[i] = t8;
		i += 1;
	}

	return out;	
}

#[returnaddress="stack"]
fn _memcpy_salt_v1(
	reg ptr u8[SIG_FULL_SIZE] out,
	reg ptr u8[PNC_SALT_SIZE] in
) -> reg ptr u8[SIG_FULL_SIZE]
{

	reg u64 i t64;

	i = 0;
	while(i < PNC_SALT_SIZE)
	{
		t64 = in[u64 i];
		out[u64 SIG_SALT_IDX +  i] = t64;
		i += 1;
	}

	return out;
}

inline fn __memcpy_salt_v1(
	stack u8[SIG_FULL_SIZE] out,
	stack u8[PNC_SALT_SIZE] in
) -> stack u8[SIG_FULL_SIZE]
{
	reg ptr u8[SIG_FULL_SIZE] a;
	reg ptr u8[PNC_SALT_SIZE] b;

	a = out;
 	b = in;

 	a = _memcpy_salt_v1(a,b);
 	out = a;

 	return out;
}

#[returnaddress="stack"]
fn _memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] reg ptr u8[PNC_SALT_SIZE] in
) -> reg u64
{

	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_SALT_SIZE)
	{
		t64 = in[u64 i];
		[out + 0] = t64;
		out += 8;
		i += 1;
	}

	return out;
}

inline fn __memcpy_salt(
	#[public]  reg u64 out,
	#[poly=in] stack u8[PNC_SALT_SIZE] in
) -> reg u64
{
	reg ptr u8[PNC_SALT_SIZE] a;

	a = in;

 	out = _memcpy_salt(out,a);

 	return out;
}

inline
fn _memcpy_salt_from_sig(
	#[poly=in] stack u8[PNC_SALT_SIZE] out,
	#[public]  reg u64 in
) -> stack u8[PNC_SALT_SIZE], reg u64
{

	reg u64 i t64;

	i = 0;
	while(i < PNC_U64_SALT_SIZE)
	{
		t64 = [in + 0];
		out[u64 i] = t64;
		in += 8;
		i += 1;
	}

	return out, in;
}

inline fn __memcpy_salt_from_sig(
	#[poly=in] stack u8[PNC_SALT_SIZE] out,
	#[public]  reg u64 in
) -> stack u8[PNC_SALT_SIZE], reg u64
{
	reg ptr u8[PNC_SALT_SIZE] a;

	a = out;
 	a, in = _memcpy_salt_from_sig(a, in);
 	out = a;

 	return out, in;
}

inline
fn __copy_seed_from_proofs(
	stack u8[TREE_NODES_2_SIZE] tree, 
	stack u8[SIG_PROOFS_SIZE] proofs, 
	reg u64 tree_idx,
	reg u64 proofs_idx
) -> stack u8[TREE_NODES_2_SIZE], reg u64
{
	reg u64 i t;

	i = 0;
	while(i < PNC_U64_SEED_SIZE)
	{	
		t = proofs[u64 proofs_idx];
		tree[u64 tree_idx] = t;

		proofs_idx += 1;
		tree_idx += 1;
		i += 1;
	}

	return tree, proofs_idx;
}
inline
fn __copy_seed_from_proofs2(
	stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] tree, 
	stack u8[SIG_PROOFS_SIZE] proofs, 
	reg u64 tree_idx,
	reg u64 proofs_idx
) -> stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE], reg u64
{
	reg u64 i t;

	i = 0;
	while(i < PNC_U64_SEED_SIZE)
	{	
		t = proofs[u64 proofs_idx];
		tree[u64 tree_idx] = t;

		proofs_idx += 1;
		tree_idx += 1;
		i += 1;
	}

	return tree, proofs_idx;
}

inline
fn __copy4Words_to_iSeedsTree(
	reg ptr u8[FULL_TREE_SIZE_1] tree, 
	reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	reg u64 idx_1, 
	reg u64 idx_2
) -> reg ptr u8[FULL_TREE_SIZE_1]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{t = tmp.[u64 idx_2 + z * 8]; tree.[u64 idx_1 + z * 8] = t;}

	return tree;
}


