inline fn __copy_full_tree_to_trees(
	#[secret] stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
	#[public] stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_have,
	#[public] stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_exists,
	#[secret] stack u8[TREE_NODES_2_SIZE] seeds_tree,
	#[public] stack u8[TREE_NUM_NODES_2] seeds_tree_have,
	#[public] stack u8[TREE_NUM_NODES_2] seeds_tree_exists,
	#[public] reg u64 base_seeds
) -> stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE], 
	 stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2], 
	 stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2]
{
	reg u8 t;
	reg u64 idx i;

	idx = 0;
	i = base_seeds;
	i *= TREE_NUM_NODES_2;
	while(idx < TREE_NUM_NODES_2){
		t = seeds_tree_have[idx];
		seeds_have[i] = t;	

		t = seeds_tree_exists[idx];
		seeds_exists[i] = t;

		i += 1;
		idx = idx + 1;
	}

	idx = 0;
	i = base_seeds;
	i *= TREE_NODES_2_SIZE;
	while(idx < TREE_NODES_2_SIZE){
		t = seeds_tree[ idx];
		seeds[i] = t;

		i += 1;
		idx = idx + 1;
	}

	return seeds, seeds_have, seeds_exists;
}

inline fn __copy_full_tree_from_trees(
	#[secret] stack u8[TREE_NODES_2_SIZE] seeds,
	#[public] stack u8[TREE_NUM_NODES_2] seeds_have,
	#[public] stack u8[TREE_NUM_NODES_2] seeds_exists,
	#[secret] stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds_tree,
	#[public] stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_tree_have,
	#[public] stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_tree_exists,
	#[public] reg u64 base_seeds
) -> stack u8[TREE_NODES_2_SIZE], 
	 stack u8[TREE_NUM_NODES_2], 
	 stack u8[TREE_NUM_NODES_2]
{
	reg u8 t;
	reg u64 idx i;

	idx = 0;
	i = base_seeds;
	i *= TREE_NUM_NODES_2;
	while(idx < TREE_NUM_NODES_2){
		t = seeds_tree_have[i];
		seeds_have[idx] = t;	

		t = seeds_tree_exists[i];
		seeds_exists[idx] = t;

		i += 1;
		idx = idx + 1;
	}

	idx = 0;
	i = base_seeds;
	i *= TREE_NODES_2_SIZE;
	while(idx < TREE_NODES_2_SIZE){
		t = seeds_tree[i];
		seeds[idx] = t;

		i += 1;
		idx = idx + 1;
	}

	return seeds, seeds_have, seeds_exists;
}

inline fn __copy_round_tapes_to_tapes(
	stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
	stack u8[TAPES_FULL_SIZE] round_tapes,
	reg u64 base_tapes
) -> stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE]
{
	reg u64 t;
	reg u64 idx;

	/* u64 copy: TAPES_FULL_SIZE (4608) and base_tapes (t * TAPES_FULL_SIZE) are multiples of 8 */
	base_tapes >>= 3; /* byte offset -> u64 index */

	idx = 0;
	while(idx < TAPES_U64_FULL_SIZE){
		t = round_tapes[u64 idx];
		tapes[u64 base_tapes] = t;

		base_tapes += 1;
		idx += 1;
	}

	return tapes;
}

inline fn __copy_round_tapes_to_tapes2(
	reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
	stack u8[TAPES_FULL_SIZE] round_tapes, 
	reg u64 base_tapes
) -> reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE]
{
	reg u8 t;
	reg u64 idx;

	idx = 0;
	while(idx < TAPES_FULL_SIZE){
		t = round_tapes[idx];
		tapes[base_tapes] = t;

		base_tapes += 1;
		idx += 1;
	}

	return tapes;
}

inline fn __copy_round_tapes_from_tapes(
	#[poly=tapes] stack u8[TAPES_FULL_SIZE] round_tapes,
	#[poly=tapes] stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes, 
	#[public]     reg u64 base_tapes
) -> stack u8[TAPES_FULL_SIZE]
{
	reg u64 idx t;

	idx = 0;
	while(idx < TAPES_FULL_SIZE){
		t = tapes.[u64 base_tapes];
		round_tapes.[u64 idx] = t;
		

		base_tapes += 8;
		idx = idx + 8;
	}

	return round_tapes;
}

inline fn __copy_round_tapes_from_tapes2(
	#[poly=tapes] stack u8[TAPES_FULL_SIZE] round_tapes,
	#[poly=tapes] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes, 
	#[public]     reg u64 base_tapes
) -> stack u8[TAPES_FULL_SIZE]
{
	reg u64 idx t;

	idx = 0;
	while(idx < TAPES_FULL_SIZE){
		t = tapes.[u64 base_tapes];
		round_tapes.[u64 idx] = t;
		

		base_tapes += 8;
		idx = idx + 8;
	}

	return round_tapes;
}

inline fn __copy_round_msgs_from_msgs(
	#[poly=input] stack u8[MSGS_FULL_SIZE] output,
	#[poly=input] stack u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] input,
	#[public]     reg u64 idx
) -> stack u8[MSGS_FULL_SIZE]
{
	reg u64 t x;

	t = 0;
	while(t < MSGS_U64_FULL_SIZE){
		x = input.[u64  idx];
		output[u64  t] = x;

		idx = idx + 8;
		t = t + 1;
	}

	return output;
}

inline fn __copy_round_msgs_to_msgs(
	#[poly=round_msgs] stack u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] msgs,
	#[poly=round_msgs] stack u8[MSGS_FULL_SIZE] round_msgs, 
	#[public]          reg u64 base_msgs
) -> stack u8[PNC_N_ROUNDS * MSGS_FULL_SIZE]
{
	reg u64 t idx;

	idx = 0;
	while(idx < MSGS_U64_FULL_SIZE){
		t = round_msgs[u64  idx];
		msgs.[u64  base_msgs] = t;

		base_msgs = base_msgs + 8;
		idx = idx + 1;
	}

	return msgs;
}

fn _copy_tapes_aux(
	#[poly=tapes] reg ptr u8[TAPE_AUX_SIZE] tapes_aux, 
	#[poly=tapes] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes, 
	#[public]     reg u64 tapes_aux_idx
) -> reg ptr u8[TAPE_AUX_SIZE]
