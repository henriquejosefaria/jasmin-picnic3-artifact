#[returnaddress="stack"]
fn _memcpy_4Words_from_reg(
	reg ptr u8[PNC_INPUT_SIZE] out,
	#[public]   reg u64 in
) -> reg ptr u8[PNC_INPUT_SIZE]
{
	reg u64 i t64;

	i = 0;
	while( i < PNC_U64_INPUT_SIZE)
	{
		t64 = [in + i * 8];
		out[u64 i] = t64;
		i += 1;
	}

	return out;	
}

inline fn __memcpy_4Words_from_reg(
	#[secret] stack u8[PNC_INPUT_SIZE] out,
	#[public] reg u64 in
) -> stack u8[PNC_INPUT_SIZE]
{
	reg ptr u8[PNC_INPUT_SIZE] a;

	a = out;
	a = _memcpy_4Words_from_reg(a, in);
	out = a;

	return out;
}

