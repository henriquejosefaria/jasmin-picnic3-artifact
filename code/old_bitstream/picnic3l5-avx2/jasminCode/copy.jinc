#[returnaddress="stack"]
fn __copy_seed_to_proof_v1(
	reg ptr u8[PNC_N_OPENED_ROUNDS * PROOF_FULL_SIZE] out,
	reg ptr	u8[FULL_TREE_SIZE_2] in,
	reg u64 out_pos,
	reg u64 in_pos
