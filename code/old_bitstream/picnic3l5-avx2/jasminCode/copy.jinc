#[returnaddress="stack"]
fn __copy_seed_from_sig(
	reg ptr u8[TREE_NODES_1_SIZE] out,
	reg u64 in,
	reg u64 out_pos
) -> reg ptr u8[TREE_NODES_1_SIZE], reg u64
{
