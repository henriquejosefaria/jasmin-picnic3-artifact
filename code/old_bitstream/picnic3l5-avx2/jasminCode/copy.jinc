#[returnaddress="stack"]
fn __copy_digest_to_tree(
	reg ptr u8[TREE_NODES_3_SIZE] out,
	reg u64 in,
	reg u64 out_pos
) -> reg ptr u8[TREE_NODES_3_SIZE], reg u64
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_DIGEST_SIZE
	{
		t = [in + 0];
		out.[u64 out_pos + z*8] = t;

		in += 8;
	}

	return out, in;
}

#[returnaddress="stack"]
fn __copy_leaf_to_tree(
	reg ptr u8[TREE_NODES_3_SIZE] out,
	reg ptr u8[CV_FULL_SIZE] in,
	reg u64 out_pos,
	reg u64 in_pos
) -> reg ptr u8[TREE_NODES_3_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_DIGEST_SIZE
	{
		t = in.[u64 in_pos + z * 8];
		out.[u64 out_pos + z * 8] = t;
	}

	return out;
}

#[returnaddress="stack"]
fn _copy_full_tree_v1(
	reg ptr u8[FULL_TREE_SIZE_2] seeds_tree,
	reg ptr u8[PNC_N_ROUNDS * FULL_TREE_SIZE_2] seeds,
	reg 	u64 seeds_tree_idx
) -> reg ptr u8[FULL_TREE_SIZE_2]
{
	reg u8 x;
	reg u64 t seeds_idx;

	seeds_idx = seeds_tree_idx;

	t = 0;
	while(t < FULL_TREE_SIZE_2){
		
		x = seeds[seeds_idx];
		seeds_tree[t] = x;

		seeds_idx = seeds_idx + 1;
		t = t + 1;
	}

	return seeds_tree;
}

inline fn __copy_full_tree_v1(
	stack u8[FULL_TREE_SIZE_2] seeds_tree,
	reg ptr u8[PNC_N_ROUNDS * FULL_TREE_SIZE_2] seeds,
	reg 	u64 seeds_tree_idx
) -> stack u8[FULL_TREE_SIZE_2]
{
	reg ptr u8[FULL_TREE_SIZE_2] a;

	a = seeds_tree;
	a = _copy_full_tree_v1(a, seeds, seeds_tree_idx);
	seeds_tree = a;

	return seeds_tree;
}


#[returnaddress="stack"]
fn _copy_full_tree(
	#[secret] reg ptr u8[TREE_NODES_2_SIZE] seeds_tree,
	#[public] reg ptr u8[TREE_NUM_NODES_2] seeds_tree_exists,
	#[secret] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
	#[public] reg ptr u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_exists,
	#[public] reg u64 seeds_tree_idx
) -> reg ptr u8[TREE_NODES_2_SIZE], reg ptr u8[TREE_NUM_NODES_2]
{
	reg u8 x;
	reg u64 t seeds_idx;


	t = 0;
	seeds_idx = seeds_tree_idx;
	seeds_idx *= TREE_NODES_2_SIZE;
	while(t < TREE_NODES_2_SIZE){
		
		x = seeds[seeds_idx];
		seeds_tree[t] = x;

		seeds_idx = seeds_idx + 1;
		t = t + 1;
	}

	t = 0;
	seeds_idx = seeds_tree_idx;
	seeds_idx *= TREE_NUM_NODES_2;
	while(t < TREE_NUM_NODES_2)
	{
		x = seeds_exists[seeds_idx];
		seeds_tree_exists[t] = x;
		t += 1;
	}

	return seeds_tree, seeds_tree_exists;
}

inline fn __copy_full_tree(
	#[secret] stack u8[TREE_NODES_2_SIZE] seeds_tree,
	#[public] stack u8[TREE_NUM_NODES_2] seeds_tree_exists,
	#[secret] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
	#[public] reg ptr u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_exists,
	#[public] reg u64 seeds_tree_idx
) -> stack u8[TREE_NODES_2_SIZE], stack u8[TREE_NUM_NODES_2]
{
	reg ptr u8[TREE_NODES_2_SIZE] a;
	reg ptr u8[TREE_NUM_NODES_2] b;

	a = seeds_tree;
	b = seeds_tree_exists;
	a, b = _copy_full_tree(a, b, seeds, seeds_exists, seeds_tree_idx);
	seeds_tree = a;
	seeds_tree_exists = b;

	return seeds_tree, seeds_tree_exists;
}
