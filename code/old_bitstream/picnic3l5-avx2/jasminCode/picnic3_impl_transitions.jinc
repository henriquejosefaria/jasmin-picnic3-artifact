require "picnic3_aux.jinc"
require "picnic3_impl.jinc"
require "picnic3_impl_verify.jinc"

inline
fn __get_proofs_from_sig(
  stack u8[PROOFS_FULL_SIZE] proofs, 
  stack u8[CHALLENGE_C_SIZE] challengeC, 
  stack u8[CHALLENGE_P_SIZE] challengeP, 
  reg u64 sig,
  reg u8 t8
) -> stack u8[PROOFS_FULL_SIZE], reg u8
{
  reg u8 c;
  reg u16 t16 P_index_u16;
  reg u64 proof_idx P_index;

  stack u16 s_t16;
  stack u64 s_proof_idx s_sig;

  reg ptr u8[CHALLENGE_C_SIZE] reg_challengeC;

  s_sig = sig;

  c = 0;
  t16 = 0;
  s_proof_idx = 0;
  while(t16 < PNC_N_ROUNDS)
  { 
    reg_challengeC = challengeC;
    c = _contains_challengeC_2(reg_challengeC, t16);

    if(c == 1)
    { 
      s_t16 = t16;
      reg_challengeC = challengeC;
      P_index = __indexOf(reg_challengeC, t16);
      P_index_u16 = challengeP[u16 P_index];
      s_t16 = t16;

      proof_idx = s_proof_idx;
      proof_idx *= PROOF_FULL_SIZE;
      
      sig = s_sig;
      proofs, sig, t8 = _copy_proof_from_sig(proofs, sig, proof_idx, P_index_u16, t8);
      s_sig = sig;

      if(t8 == 1)
      {
        s_t16 = PNC_N_ROUNDS;
      }

      proof_idx = s_proof_idx;
      proof_idx += 1;
      s_proof_idx = proof_idx;

      t16 = s_t16;
    }

    t16 += 1;
  }

  return proofs, t8;
}

inline fn __createRandomTapes(
  #[secret] stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
  #[secret] stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
  #[secret] stack u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 t
) -> stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE]
{
  reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] a;
  reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] b;
  reg ptr u8[PNC_SALT_SIZE] c;

  a = tapes;
  b = seeds;
  c = salt;
  a = _createRandomTapes(a,b,c,t);
  tapes = a;

  return tapes;
}

inline fn __createRandomTapes_verify(
  #[secret] stack u8[TAPES_FULL_SIZE] tapes,
  #[secret] stack u8[TREE_NODES_2_SIZE] seeds,
  #[secret] stack u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 t
) -> stack u8[TAPES_FULL_SIZE]
{
  reg ptr u8[TAPES_FULL_SIZE] a;
  reg ptr u8[TREE_NODES_2_SIZE] b;
  reg ptr u8[PNC_SALT_SIZE] c;

  a = tapes;
  b = seeds;
  c = salt;
  a = _createRandomTapes_verify(a,b,c,t);
  tapes = a;

  return tapes;
}

inline fn __computeAuxTape(
	#[secret] stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
	#[secret] stack u8[PNC_N_ROUNDS * MZD_SIZE] input_masks,
	#[secret] stack u8[MZD_SIZE] privKey,
	#[public] reg u64 pos
) -> stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE], stack u8[PNC_N_ROUNDS * MZD_SIZE]
{
	reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] a;
	reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] b;	
	reg ptr u8[MZD_SIZE] c;

	a = tapes;
	b = input_masks;
	c = privKey;
	a,b = _computeAuxTape(a,b,c,pos);
	tapes = a;
	input_masks = b;

	return tapes, input_masks;
}

inline fn __assemble_proof(
	#[public]      reg u64 sig, 
	#[poly=seeds]  stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
	#[public]      stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] seeds_exists,
	#[poly=tapes]  stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
  	#[poly=_salt]  stack u8[PNC_SALT_SIZE] salt,
	#[poly=inputs] stack u8[PNC_N_ROUNDS * MZD_SIZE] inputs,
	#[poly=msgs]   stack u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] msgs,
	#[public]      stack u8[CHALLENGE_C_SIZE] challengeC,
	#[public]      stack u8[CHALLENGE_P_SIZE] challengeP
) -> reg u64
{

	reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] a;
	reg ptr u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] b;
	reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] c;
	reg ptr  u8[PNC_SALT_SIZE] d;
	reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] e;
	reg ptr u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] f;
	reg ptr u8[CHALLENGE_C_SIZE] g;
	reg ptr u8[CHALLENGE_P_SIZE] h;

	a = seeds;
	b = seeds_exists;
	c = tapes;
	d = salt;
	e = inputs;
	f = msgs;
	g = challengeC;
	h = challengeP;
	sig = _assemble_proof(sig, a, b, c, d, e, f, g, h);

	return sig;
}













