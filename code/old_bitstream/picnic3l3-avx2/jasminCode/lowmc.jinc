#[returnaddress="stack"]
fn __sbox_uint64_lowmc_192_192_4(
	reg u256 ymm4
) ->  reg u256
{
	reg u256 ymm0 ymm1 ymm2 ymm3 ymm5 ymm6;

	ymm1 = ymm4 & bitmask_a[:u256 0]; // vpand	.LC7(%rip), %ymm4, %ymm1
	ymm2 = ymm4 & bitmask_b[:u256 0]; // vpand	.LC8(%rip), %ymm4, %ymm2
	ymm4 &= bitmask_c[:u256 0];		  // vpand	.LC9(%rip), %ymm4, %ymm4

	ymm0 = #VPSRL_4u64(ymm1,62);	  // vpsrlq	$62, %ymm1, %ymm0
	ymm1 = #VPSLL_4u64(ymm1,2);		  // vpsllq	$2, %ymm1, %ymm1
	ymm0 = #VPERMQ(ymm0, 147);		  // vpermq	$147, %ymm0, %ymm0
	ymm1 |= ymm0;					  // vpor	%ymm0, %ymm1, %ymm1

	ymm0 = #VPSRL_4u64(ymm2,63);	  // vpsrlq	$63, %ymm2, %ymm0
	ymm0 = #VPERMQ(ymm0, 147);		  // vpermq	$147, %ymm0, %ymm0
	ymm2 = #VPSLL_4u64(ymm2,1);		  // vpsllq	$1, %ymm2, %ymm2
	ymm3 = #VPANDN_256(ymm4, ymm1);   // vpandn	%ymm1, %ymm4, %ymm3 - DIFF - CHANGED 4U64 TO 256
	ymm2 |= ymm0;					  // vpor	%ymm0, %ymm2, %ymm2

	ymm0 = ymm4 & ymm2;				  // vpand	%ymm2, %ymm4, %ymm0
	ymm3 ^= ymm2;					  // vpxor	%ymm2, %ymm3, %ymm3
	ymm0 ^= ymm1;					  // vpxor	%ymm1, %ymm0, %ymm0

	ymm5 = #VPSLL_4u64(ymm3,63);	  // vpsllq	$63, %ymm3, %ymm5
	ymm1 |= ymm2;					  // vpor	%ymm2, %ymm1, %ymm1
	ymm6 = #VPSLL_4u64(ymm0,62);	  // vpsllq	$62, %ymm0, %ymm6
	ymm5 = #VPERMQ(ymm5, 57);		  // vpermq	$57, %ymm5, %ymm5
	ymm1 ^= ymm4;					  // vpxor	%ymm4, %ymm1, %ymm1

	ymm0 = #VPSRL_4u64(ymm0,2);		  // vpsrlq	$2, %ymm0, %ymm0
	ymm3 = #VPSRL_4u64(ymm3,1);		  // vpsrlq	$1, %ymm3, %ymm3
	ymm6 = #VPERMQ(ymm6, 57);		  // vpermq	$57, %ymm6, %ymm6

	ymm0 |= ymm6;					  // vpor	%ymm6, %ymm0, %ymm0
	ymm3 |= ymm5;					  // vpor	%ymm5, %ymm3, %ymm3
	ymm0 ^= ymm3;					  // vpxor	%ymm3, %ymm0, %ymm0
	ymm0 ^= ymm1;					  // vpxor	%ymm1, %ymm0, %ymm0

	return ymm0;
}

/*
 * This function computes PICNIC3's public key given a 
 * private key and a plaintext as input.
 */
inline fn _n_lowmc(
	 stack u8[MZD_SIZE] lowmc_key,
	 reg u256 ymm0
) ->  reg u256
{
	stack u8[MZD_SIZE] c;

	reg ptr u8[MZD_SIZE] reg_c;
	reg ptr u8[MZD_SIZE] reg_lowmc;

	inline int z;

	reg_lowmc = lowmc_key;
	ymm0 = _mzd_addmul_v_uint64_192_v2(ymm0, reg_lowmc, k_matrix[0 : MATRIX_ROUND]);

	for z=0 to LOWMC_R
	{
		ymm0 = __sbox_uint64_lowmc_192_192_4(ymm0);
		c[:u256 0] = ymm0;

		reg_c = c;
		ymm0 = #set0_256();
		ymm0 = _mzd_addmul_v_uint64_192_v2(ymm0, reg_c, l_matrix[z * MATRIX_ROUND : MATRIX_ROUND]);

		ymm0 ^= r_c.[:u256 z * MZD_SIZE];

		reg_lowmc = lowmc_key;
		ymm0 = _mzd_addmul_v_uint64_192_v2(ymm0, reg_lowmc, k_matrix[(z + 1) * MATRIX_ROUND : MATRIX_ROUND]);
	}

	return ymm0;
}

