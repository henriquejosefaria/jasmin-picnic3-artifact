require "keccakf1600.jinc"

/* TO DELETE */

type keccak_updstate = u64[26];

/**
 Last u64 word of keccak_updstate is filled with:
  - byte[0] - at_position (pre: 0 <= at <= 200)
  - byte[1] - r64-1, where r64 = 8*r8 (rate in bytes) -- (pre: 0 < r64 <= 25)
  - byte[2] - Trail Byte
*/


fn _init_updstate_avx2
( reg mut ptr keccak_updstate st
, reg ui8 r64 // 9 <= r64 < 25 
, reg u8 trailb // 0 <= trailb < 256
) -> reg ptr keccak_updstate /* st */
{
  inline int i;
  reg u256 r256;
  reg u64 status, t;

  r256 = #set0_256();

  for i = 0 to 6 {
      st[:u256 i] = r256;
    }

  st[24] = 0;
  status = (64u) trailb;
  status <<= 8;
  r64 = (8ui) ((8u)r64 - 1);
  t = (64u) (8u) r64;
  status += t;
  status <<= 8;
  st[25] = status;

  return st;
}


/**
 When we read the update-data from the state (r8 and at-position), we guarantee
 that it is wellformed, that is:
  - rate in bytes (r8):  0 < r8 < 200  &&  r8 %| 8
  - at-position (at):  0 <= at < r8
 This would allow to establish safety independently of the given state.
*/
fn _ststatus_data
( reg u64 ststatus
) -> reg u8    /* trailb */
   , reg ui64  /* r8 ; 8 %| r8 /\ 0 < r8 <= 200  */
   , reg ui64  /* at  ; 0 <= at < r8 */
/* ensures:
    8 |% r8
    0 < r8 <= 200
    0 <= at < r8  */
{
 reg u64 r8, at, c_0, c_200;
 reg ui64 r8_ui, at_ui;
 reg u8 trailb;

 at = ststatus;
 at &= 0xFF;
 ststatus >>= 8;
 r8 = ststatus;
 r8 &= 255; // 0 <= r8 <= 255
 r8 += 1;   // 0 < r8 <= 256
 r8 <<= 3;  // 8 %| r8  /\  0 < r8 <= 2048
 c_200 = 200;
 r8 = c_200 if r8 > 200;  // 8 %| r8  /\  0 < r8 <= 200
 c_0 = 0;
 at = c_0 if r8 <= at;  // 0 <= at < r8
 ststatus >>= 8;
 trailb = (8u) ststatus;

 r8_ui = (64ui)r8;
 at_ui = (64ui)at;
 return trailb, r8_ui, at_ui;
}

fn _finish_updstate_avx2
( reg mut ptr keccak_updstate st
) -> reg ptr keccak_updstate /* st */
{
  reg u64 ststatus;
  reg ui64 at, r8;
  reg u8 trailb;
  #[declassify] ststatus = st[25];
  trailb, r8, at = _ststatus_data(ststatus);
  st.[:u8 at] ^= trailb;
  st.[:u8 r8-1] ^= 0x80;
  st.[:u32 8*25] &= 0xFF00FF00; // clear trail-byte and at-position
  
  return st;
}


// keccak_ststatus, init_updstate_avx2, and finish_updstate_avx2 (public API
// export wrappers) removed as dead code: nothing in this codebase calls them
// (the real code paths call the internal _init_updstate_avx2/
// _finish_updstate_avx2 directly), and as `export fn`s they were still forced
// through full constant-time annotation for no functional benefit.





/*
 *  REMARK: the remaining of this file is expected to be kept in sync. with its array version's
 *  counterpart ("keccak1600_updstate_ASIZE.jinc")
 *
 */


// _add_m_updstate_avx2 and _absorb_m_updstate_avx2 removed as dead code:
// their only caller was the dead export absorb_m_updstate_avx2 (removed
// below), which nothing else in this codebase called either.

fn _dump_m_updstate_avx2
( reg ui64 buf
, reg const ptr keccak_state st
, reg ui64 at     // at+ASIZE <= r8
, reg ui64 upto   // at <= upto <= r8
) -> reg ui64     /* buf */
   , reg ui64     /* at */
{
  reg ui64 newat, buf2, len;
  reg u64 t64, at8, upto8;
  reg u8 sh;

  at8 = (64u) at;
  at8 &= 0x07; // byte position in stword

  if (at8 != 0) { // needs to dump remainder of first word...
    len = upto;
    len -= at; // len = upto-at (bytes to process)
    at >>= 3; at <<= 3; // at = 8*(at/8) (start of stword)
    t64 = st.[at];
    sh = (8u) at8;
    sh <<= 3;   // bits to shift...
    t64 >>= (sh & 63);
    buf2 = __m_rlen_write_upto8(buf, t64, len);
    len += (64ui) at8; // bytes from the start of word
    if (len >= 8) {  // need to proccess more stwords...
      buf += 8;
      buf -= (64ui) at8;
      at += 8;       // start of next stword
    } else {         // this is the only affected stword
      buf = buf2;
      at = upto;     // its done!
    }
  }

  // now: at%8==0 || at==upto
  newat = at;
  while
    { newat += 8; }
  ( newat <= upto )
    {
      t64 = st.[:u64 at];
      [:u64 (64u) buf] = t64;
      at = newat;
      buf += 8;
    }

  // leftovers...
  if (at < upto) {
    upto8 = (64u) upto;
    upto8 &= 0x07;
    t64 = st.[at];
    buf = __m_rlen_write_upto8(buf, t64, (64ui) upto8);
  }

  at = upto;
  return buf, at;
}

fn _squeeze_m_updstate_avx2
( reg ui64 buf
, reg ui64 len
, reg mut ptr keccak_updstate st
) -> reg ui64                 /* buf */
   , reg ptr keccak_updstate  /* st */
{
  reg u64 ststatus;
  reg ui64 r8, at;
  reg ptr keccak_state stk;

  #[declassify] ststatus = st[25];
  _, r8, at = _ststatus_data(ststatus); // 0 < r8 < 200; r8 |% 8; 0 <= at <= r8
  stk = st[0:25];
  () = #spill(st);

  if ( at == 0 ) {
    stk = _keccakf1600_st25_avx2(stk);
    at = 0; // obs: no need to spill/unspill(at)!
  }

  len += at;

  while (r8 < len) {
    buf, at = _dump_m_updstate_avx2(buf, stk, at, r8);
    () = #spill(r8, at, len, buf);
    stk = _keccakf1600_st25_avx2(stk);
    () = #unspill(r8, at, len, buf);
    len -= r8;
    at = 0;
  }

  len = len;
  buf, at = _dump_m_updstate_avx2(buf, stk, at, len);

  () = #unspill(st);
  st[0:25] = stk;
  // if ( at == r8 ) at = 0; // avoidable because r8_at() returns 0<=at<r8
  st.[:u8 8*25] = (8u) (64u) at;

  return buf, st;
}

// absorb_m_updstate_avx2 and squeeze_m_updstate_avx2 (public API export
// wrappers) removed as dead code: nothing calls them. _squeeze_m_updstate_avx2
// itself is kept above since it's genuinely used by keccak_avx2.jinc.