		param int SEMI_SIG_CHALLENGE_C_U64_IDX = SEMI_SIG_CHALLENGE_C_IDX >> 3;
		param int SEMI_SIG_CHALLENGE_P_U64_IDX = SEMI_SIG_CHALLENGE_P_IDX >> 3;
