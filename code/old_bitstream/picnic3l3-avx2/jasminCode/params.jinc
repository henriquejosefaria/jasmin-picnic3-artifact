		param int SIG_CHALLENGE_P_U16_SIZE     = SIG_CHALLENGE_P_SIZE >> 1;
		param int SIG_PROOFS_U16_SIZE          = SIG_PROOFS_SIZE >> 1;


		param int SIG_H_U16_IDX     		  = SIG_H_IDX >> 1;
		param int SIG_CHALLENGE_C_U16_IDX	  = SIG_CHALLENGE_C_IDX >> 1;
		param int SIG_CHALLENGE_P_U16_IDX 	  = SIG_CHALLENGE_P_IDX >> 1;
		param int SIG_I_SEED_INFO_LEN_U16_IDX = SIG_I_SEED_INFO_LEN_IDX >> 1;

*/
		param int SIG_CHALLENGE_C_U16_SIZE = SIG_CHALLENGE_C_SIZE >> 1;
		param int SIG_FULL_U16_SIZE = SIG_FULL_SIZE >> 1;


	/* PARAMETERS U64 */

		param int SIG_U64_CHALLENGE_SIZE  = SIG_CHALLENGE_SIZE >> 3;
/*
		param int SIG_H_U64_IDX           = SIG_H_IDX >> 3;
		param int SIG_CHALLENGE_C_U64_IDX = SIG_CHALLENGE_C_IDX >> 3;
		param int SIG_CHALLENGE_P_U64_IDX = SIG_CHALLENGE_P_IDX >> 3;
*/
		param int SIG_U64_FULL_SIZE = SIG_FULL_SIZE >> 3;



	
