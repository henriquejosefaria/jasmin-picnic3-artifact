require "params.jinc"
require "keccak/keccak1600x4_updstate.jinc"

namespace A1x4 {
  param int _ASIZE = 1;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A2x4 {
  param int _ASIZE = 2;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A8x4 {
  param int _ASIZE = 8;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A24x4 {
  param int _ASIZE = PNC_INPUT_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A32x4 {
  param int _ASIZE = PNC_SALT_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A48x4 {
  param int _ASIZE = COMMITMENT_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A64x4 {
  param int _ASIZE = 2 * MAX_SEED_SIZE_BYTES;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A192x4 {
  param int _ASIZE = TAPE_SIZE_BYTES;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A768x4 {
  param int _ASIZE = PNC_DIGEST_SIZE * PNC_N_MPC_PARTIES;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

namespace A1536x4 {
  param int _ASIZE = MSGS_FULL_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

/**************************/
/*     HASH FUNCTIONS     */
/**************************/

/*
 * Hash one seed with a salt, the round index and the node index
 * to compute two new seeds (times 4).
 */
#[returnaddress="stack"]
fn _hashSeed_x4_1(
  #[secret]         reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] out,
  #[poly=inputSeed] reg ptr u8[TREE_NODES_1_SIZE] inputSeed,
  #[poly=salt]      reg ptr u8[PNC_SALT_SIZE] salt,
  #[public]         reg u64 inputSeed_idx,
  #[poly=repIndex]  reg u16 repIndex,
  #[poly=nodeIndex] reg u16 nodeIndex
) -> reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 t;
  inline int z;

  stack u8[1] prefix_s;
  stack u8[2] t16b_s;
  stack u8[8] t16x4;
  stack u8[TREE_DATA_SIZE*4] inputSeeds_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16b;
  reg ptr u8[2] t16x40 t16x41 t16x42 t16x43;
  reg ptr u8[24] buf0, buf1, buf2, buf3;
  reg ptr u8[2 * MAX_SEED_SIZE_BYTES] out0, out1, out2, out3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*********************************/
  /* EXTRACT INPUT SEEDS (NO SLICE) */
  /*********************************/

  for z = 0 to (TREE_DATA_SIZE*4) / 8 {
    t = inputSeed.[:u64 inputSeed_idx + z*8];
    inputSeeds_s[:u64 z] = t;
  }

  () = #spill(out, salt, repIndex, nodeIndex);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 1;
  prefix_s[:u8 0] = HASH_PREFIX_1;
  prefix = prefix_s;
  st = A1x4::_absorb_bcast_updstate_avx2x4(st, prefix, len);

  /******************/
  /*   SLICE THIS   */
  /******************/

  len = 24;
  buf0 = inputSeeds_s[0:24];
  buf1 = inputSeeds_s[24:24];
  buf2 = inputSeeds_s[48:24];
  buf3 = inputSeeds_s[72:24];
  st = A24x4::_absorb_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  len = 32;
  () = #unspill(salt);
  st = A32x4::_absorb_bcast_updstate_avx2x4(st, salt, len);

  len = 2;
  () = #unspill(repIndex);
  t16b_s[:u16 0] = repIndex;
  t16b = t16b_s;
  st = A2x4::_absorb_bcast_updstate_avx2x4(st, t16b, len);
 
  () = #unspill(nodeIndex);
  t16x4[:u16 0] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 1] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 2] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 3] = nodeIndex;

  t16x40 = t16x4[0:2];
  t16x41 = t16x4[2:2];
  t16x42 = t16x4[4:2];
  t16x43 = t16x4[6:2];

  len = 2;
  st = A2x4::_absorb_updstate_avx2x4(st, t16x40, t16x41, t16x42, t16x43, len);
  st = _finish_updstate_avx2x4(st);


  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  () = #unspill(out);

  len = 2 * PNC_SEED_SIZE;
  out0 = out[0:2 * MAX_SEED_SIZE_BYTES];
  out1 = out[2*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  out2 = out[4*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  out3 = out[6*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  _, out0, out1, out2, out3 = 
    A64x4::_squeeze_updstate_avx2x4(st, out0, out1, out2, out3, len);
  out[0:2 * MAX_SEED_SIZE_BYTES] = out0;
  out[2*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out1;
  out[4*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out2;
  out[6*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out3;

  return out;
}

/*
 * Hash one seed with a salt, the round index and the node index
 * to compute two new seeds (times 4).
 */
#[returnaddress="stack"]
fn _hashSeed_x4_2(
  #[secret]         reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] out,
  #[poly=inputSeed] reg ptr u8[TREE_NODES_2_SIZE] inputSeed,
  #[poly=salt]      reg ptr u8[PNC_SALT_SIZE] salt,
  #[public]         reg u64 inputSeed_idx,
  #[poly=repIndex]  reg u16 repIndex,
  #[poly=nodeIndex] reg u16 nodeIndex
) -> reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES]
{

  reg u64 i t;
  reg ui64 len;
  reg ui8 x;
  reg u8 y;

  stack u8[1] prefix_s;
  stack u8[2] t16b_s;
  stack u8[8] t16x4;
  stack u8[TREE_DATA_SIZE*4] buf;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16b;
  reg ptr u8[2] t16x40 t16x41 t16x42 t16x43;
  reg ptr u8[24] buf0, buf1, buf2, buf3;
  reg ptr u8[2 * MAX_SEED_SIZE_BYTES] out0, out1, out2, out3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  () = #spill(out);
  () = #spill(inputSeed);
  () = #spill(inputSeed_idx);
  () = #spill(salt);
  () = #spill(repIndex);
  () = #spill(nodeIndex);

  /*****************************/
  /*         SET STATE         */
  /*****************************/
  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 1;
  prefix_s[:u8 0] = HASH_PREFIX_1;
  prefix = prefix_s;
  st = A1x4::_absorb_bcast_updstate_avx2x4(st, prefix, len);

  /******************/
  /*   SLICE THIS   */
  /******************/

  () = #unspill(inputSeed);
  () = #unspill(inputSeed_idx);
  i=0;
  while(i < TREE_DATA_SIZE*4)
  {
    t = inputSeed.[:u64 inputSeed_idx];
    buf.[:u64 i] = t;
    inputSeed_idx += 8;
    i += 8;
  }
  () = #spill(inputSeed);
  () = #spill(inputSeed_idx);

  len = 24;
  buf0 = buf[0:24];
  buf1 = buf[24:24];
  buf2 = buf[48:24];
  buf3 = buf[72:24];
  st = A24x4::_absorb_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  len = 32;
  () = #unspill(salt);
  st = A32x4::_absorb_bcast_updstate_avx2x4(st, salt, len);

  len = 2;
  () = #unspill(repIndex);
  t16b_s[:u16 0] = repIndex;
  t16b = t16b_s;
  st = A2x4::_absorb_bcast_updstate_avx2x4(st, t16b, len);
  
  len = 2;
  () = #unspill(nodeIndex);
  t16x4[:u16 0] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 1] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 2] = nodeIndex;
  nodeIndex += 1;
  t16x4[:u16 3] = nodeIndex;

  t16x40 = t16x4[0:2];
  t16x41 = t16x4[2:2];
  t16x42 = t16x4[4:2];
  t16x43 = t16x4[6:2];

  st = A2x4::_absorb_updstate_avx2x4(st, t16x40, t16x41, t16x42, t16x43, len);
  st = _finish_updstate_avx2x4(st);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  () = #unspill(out);

  len = 2 * PNC_SEED_SIZE;
  out0 = out[0:2 * MAX_SEED_SIZE_BYTES];
  out1 = out[2*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  out2 = out[4*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  out3 = out[6*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES];
  _, out0, out1, out2, out3 = 
    A64x4::_squeeze_updstate_avx2x4(st, out0, out1, out2, out3, len);
  out[0:2 * MAX_SEED_SIZE_BYTES] = out0;
  out[2*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out1;
  out[4*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out2;
  out[6*MAX_SEED_SIZE_BYTES:2*MAX_SEED_SIZE_BYTES] = out3;

  return out;
}

#[returnaddress="stack"]
fn _hashTapes_x4(
  #[secret]  reg ptr u8[TAPES_FULL_SIZE] out,
  #[secret]  reg ptr u8[TREE_NODES_2_SIZE] seeds,
  #[secret]  reg ptr u8[PNC_SALT_SIZE] salt,
  #[public]  reg u64 round,
  #[public]  reg u16 player,
  #[public]  reg u64 base_seeds,
  #[public]  reg u64 base_out
) -> reg ptr u8[TAPES_FULL_SIZE]
{

  reg ui8 x;
  reg u8 y;
  reg u16 t16;
  reg ui64 len;
  reg u64 t;
  inline int z;

  stack u8[2] t16b_s;
  stack u8[8] t16x4;
  stack u8[TREE_DATA_SIZE * 4] seeds_s;
  stack u8[TAPE_SIZE_BYTES * 4] out_s;

  reg ptr u8[2] t16b;
  reg ptr u8[2] t16x40 t16x41 t16x42 t16x43;
  reg ptr u8[24] buf0, buf1, buf2, buf3;
  reg ptr u8[TAPE_SIZE_BYTES] out0, out1, out2, out3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*****************************/
  /*  EXTRACT SEEDS (NO SLICE) */
  /*****************************/

  for z = 0 to (TREE_DATA_SIZE * 4) / 8 {
    t = seeds.[:u64 base_seeds + z*8];
    seeds_s[:u64 z] = t;
  }

  () = #spill(out, salt, round, player, base_out);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  len = 24;
  buf0 = seeds_s[0:24];
  buf1 = seeds_s[24:24];
  buf2 = seeds_s[48:24];
  buf3 = seeds_s[72:24];

  st = A24x4::_absorb_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  () = #unspill(salt);

  len = 32;
  st = A32x4::_absorb_bcast_updstate_avx2x4(st, salt, len);

  len = 2;
  () = #unspill(round);
  t16 = round;
  t16b_s[:u16 0] = t16;

  len = 2;
  t16b = t16b_s[0:2];
  st = A2x4::_absorb_bcast_updstate_avx2x4(st, t16b, len);

  () = #unspill(player);
  t16x4[:u16 0] = player;
  player += 1;
  t16x4[:u16 1] = player;
  player += 1;
  t16x4[:u16 2] = player;
  player += 1;
  t16x4[:u16 3] = player;

  len = 2;
  t16x40 = t16x4[0:2];
  t16x41 = t16x4[2:2];
  t16x42 = t16x4[4:2];
  t16x43 = t16x4[6:2];

  st = A2x4::_absorb_updstate_avx2x4(st, t16x40, t16x41, t16x42, t16x43, len);
  st = _finish_updstate_avx2x4(st);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  len = TAPE_SIZE_BYTES;
  out0 = out_s[0:TAPE_SIZE_BYTES];
  out1 = out_s[TAPE_SIZE_BYTES:TAPE_SIZE_BYTES];
  out2 = out_s[2*TAPE_SIZE_BYTES:TAPE_SIZE_BYTES];
  out3 = out_s[3*TAPE_SIZE_BYTES:TAPE_SIZE_BYTES];
  _, out0, out1, out2, out3 =
    A192x4::_squeeze_updstate_avx2x4(st, out0, out1, out2, out3, len);

  out_s[0:TAPE_SIZE_BYTES] = out0;
  out_s[TAPE_SIZE_BYTES:TAPE_SIZE_BYTES]= out1;
  out_s[2*TAPE_SIZE_BYTES:TAPE_SIZE_BYTES] = out2;
  out_s[3*TAPE_SIZE_BYTES:TAPE_SIZE_BYTES] = out3;

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, base_out);
  for z = 0 to (TAPE_SIZE_BYTES * 4) / 8 {
    t = out_s[:u64 z];
    out.[:u64 base_out + z*8] = t;
  }

  return out;
}


/*
 * Hash one seed with a salt, the round index and the player index
 * to compute one commit (times 4).
 */
#[returnaddress="stack"]
fn commit_x4(
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] out,
  #[secret] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{

  reg ui8 x;
  reg u8 y;
  reg u16 t16;
  reg ui64 len;
  reg u64 base offset round_idx t;
  inline int z;

  stack u8[2] t16b_s;
  stack u8[8] t16x4;
  stack u8[TREE_DATA_SIZE * X4_ROUNDS] seeds_s;
  stack u8[COMMITMENT_SIZE * X4_ROUNDS] out_s;

  reg ptr u8[2] t16b;
  reg ptr u8[2] t16x40 t16x41 t16x42 t16x43;
  reg ptr u8[TREE_DATA_SIZE] buf0 buf1 buf2 buf3;
  reg ptr u8[COMMITMENT_SIZE] out0, out1, out2, out3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*****************************/
  /*  EXTRACT SEEDS (NO SLICE) */
  /*****************************/

  base = (64u) player;
  base *= PNC_SEED_SIZE;
  base += GET_LEAVES_2 * PNC_SEED_SIZE;
  offset = round;
  offset *= TREE_NODES_2_SIZE;
  base += offset;
  for z = 0 to (TREE_DATA_SIZE * X4_ROUNDS) / 8 {
    t = seeds.[:u64 base + z*8];
    seeds_s[:u64 z] = t;
  }

  round_idx = round;
  round_idx *= PNC_N_MPC_PARTIES;
  round_idx *= COMMITMENT_SIZE;
  offset = (64u) player;
  offset *= COMMITMENT_SIZE;
  round_idx += offset;

  () = #spill(out, salt, round, player, round_idx);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  len = 24;
  buf0 = seeds_s[0: TREE_DATA_SIZE];
  buf1 = seeds_s[TREE_DATA_SIZE: TREE_DATA_SIZE];
  buf2 = seeds_s[2*TREE_DATA_SIZE: TREE_DATA_SIZE];
  buf3 = seeds_s[3*TREE_DATA_SIZE: TREE_DATA_SIZE];
  st = A24x4::_absorb_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  len = 32;
  () = #unspill(salt);
  st = A32x4::_absorb_bcast_updstate_avx2x4(st, salt, len);

  len = 2;
  () = #unspill(round);
  t16 = (16u) round;
  t16b_s[:u16 0] = t16;
  t16b = t16b_s;
  st = A2x4::_absorb_bcast_updstate_avx2x4(st, t16b, len);

  () = #unspill(player);
  t16x4[:u16 0] = player;
  player += 1;
  t16x4[:u16 1] = player;
  player += 1;
  t16x4[:u16 2] = player;
  player += 1;
  t16x4[:u16 3] = player;

  len = 2;
  t16x40 = t16x4[0:2];
  t16x41 = t16x4[2:2];
  t16x42 = t16x4[4:2];
  t16x43 = t16x4[6:2];

  st = A2x4::_absorb_updstate_avx2x4(st, t16x40, t16x41, t16x42, t16x43, len);
  st = _finish_updstate_avx2x4(st);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  len = COMMITMENT_SIZE;
  out0 = out_s[0:COMMITMENT_SIZE];
  out1 = out_s[COMMITMENT_SIZE:COMMITMENT_SIZE];
  out2 = out_s[2*COMMITMENT_SIZE:COMMITMENT_SIZE];
  out3 = out_s[3*COMMITMENT_SIZE:COMMITMENT_SIZE];
  _, out0, out1, out2, out3 =
    A48x4::_squeeze_updstate_avx2x4(st, out0, out1, out2, out3, len);
  out_s[0:COMMITMENT_SIZE] = out0;
  out_s[COMMITMENT_SIZE:COMMITMENT_SIZE]= out1;
  out_s[2*COMMITMENT_SIZE:COMMITMENT_SIZE] = out2;
  out_s[3*COMMITMENT_SIZE:COMMITMENT_SIZE] = out3;

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round_idx);
  for z = 0 to (COMMITMENT_SIZE * X4_ROUNDS) / 8 {
    t = out_s[:u64 z];
    out.[:u64 round_idx + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn commit_x4_verify(
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] out,
  #[secret] reg ptr u8[TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u16 round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{

  reg ui8 x;
  reg u8 y;
  reg u16 t16;
  reg ui64 len;
  reg u64 base offset round_idx t;
  inline int z;

  stack u8[2] t16b_s;
  stack u8[8] t16x4;
  stack u8[TREE_DATA_SIZE * X4_ROUNDS] seeds_s;
  stack u8[COMMITMENT_SIZE * X4_ROUNDS] out_s;

  reg ptr u8[2] t16b;
  reg ptr u8[2] t16x40 t16x41 t16x42 t16x43;
  reg ptr u8[TREE_DATA_SIZE] buf0 buf1 buf2 buf3;
  reg ptr u8[COMMITMENT_SIZE] out0, out1, out2, out3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*****************************/
  /*  EXTRACT SEEDS (NO SLICE) */
  /*****************************/

  base = (64u) player;
  base *= TREE_DATA_SIZE;
  base += GET_LEAVES_2 * PNC_INPUT_SIZE;
  for z = 0 to (TREE_DATA_SIZE * X4_ROUNDS) / 8 {
    t = seeds.[:u64 base + z*8];
    seeds_s[:u64 z] = t;
  }

  round_idx = (64u) round;
  round_idx *= PNC_N_MPC_PARTIES;
  round_idx *= COMMITMENT_SIZE;
  offset = (64u) player;
  offset *= COMMITMENT_SIZE;
  round_idx += offset;

  () = #spill(out, salt, round, player, round_idx);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  len = 24;
  buf0 = seeds_s[0: TREE_DATA_SIZE];
  buf1 = seeds_s[TREE_DATA_SIZE: TREE_DATA_SIZE];
  buf2 = seeds_s[2*TREE_DATA_SIZE: TREE_DATA_SIZE];
  buf3 = seeds_s[3*TREE_DATA_SIZE: TREE_DATA_SIZE];
  st = A24x4::_absorb_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  len = 32;
  () = #unspill(salt);
  st = A32x4::_absorb_bcast_updstate_avx2x4(st, salt, len);

  len = 2;
  () = #unspill(round);
  t16 = round;
  t16b_s[:u16 0] = t16;
  t16b = t16b_s;
  st = A2x4::_absorb_bcast_updstate_avx2x4(st, t16b, len);

  () = #unspill(player);
  t16x4[:u16 0] = player;
  player += 1;
  t16x4[:u16 1] = player;
  player += 1;
  t16x4[:u16 2] = player;
  player += 1;
  t16x4[:u16 3] = player;

  len = 2;
  t16x40 = t16x4[0:2];
  t16x41 = t16x4[2:2];
  t16x42 = t16x4[4:2];
  t16x43 = t16x4[6:2];

  st = A2x4::_absorb_updstate_avx2x4(st, t16x40, t16x41, t16x42, t16x43, len);
  st = _finish_updstate_avx2x4(st);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  len = COMMITMENT_SIZE;
  out0 = out_s[0:COMMITMENT_SIZE];
  out1 = out_s[COMMITMENT_SIZE:COMMITMENT_SIZE];
  out2 = out_s[2*COMMITMENT_SIZE:COMMITMENT_SIZE];
  out3 = out_s[3*COMMITMENT_SIZE:COMMITMENT_SIZE];
  _, out0, out1, out2, out3 =
    A48x4::_squeeze_updstate_avx2x4(st, out0, out1, out2, out3, len);
  out_s[0:COMMITMENT_SIZE] = out0;
  out_s[COMMITMENT_SIZE:COMMITMENT_SIZE]= out1;
  out_s[2*COMMITMENT_SIZE:COMMITMENT_SIZE] = out2;
  out_s[3*COMMITMENT_SIZE:COMMITMENT_SIZE] = out3;

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round_idx);
  for z = 0 to (COMMITMENT_SIZE * X4_ROUNDS) / 8 {
    t = out_s[:u64 z];
    out.[:u64 round_idx + z*8] = t;
  }

  return out;
}


/*
 * Hash one input to compute one commit (times 4).
 */
fn _commit_h_x4(
  #[poly=in] reg ptr u8[CH_ROUND_SIZE * PNC_N_ROUNDS] out,
  #[poly=in] reg ptr u8[COMMITMENTS_SIZE * PNC_N_ROUNDS] in,
  #[public] reg u64 idx
) -> reg ptr u8[CH_ROUND_SIZE * PNC_N_ROUNDS]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 base t;
  inline int z;

  stack u8[COMMITMENTS_SIZE * X4_ROUNDS] in_s;
  stack u8[CH_ROUND_SIZE * X4_ROUNDS] out_s;

  reg ptr u8[CH_ROUND_SIZE] buf0, buf1, buf2, buf3;
  reg ptr u8[COMMITMENTS_SIZE] aux0, aux1, aux2, aux3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*********************************/
  /* EXTRACT COMMITMENTS (NO SLICE) */
  /*********************************/

  base = idx;
  base *= COMMITMENTS_SIZE;
  for z = 0 to (COMMITMENTS_SIZE * X4_ROUNDS) / 8 {
    t = in.[:u64 base + z*8];
    in_s[:u64 z] = t;
  }

  idx *= CH_ROUND_SIZE;
  () = #spill(out, idx);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  aux0 = in_s[0:COMMITMENTS_SIZE];
  aux1 = in_s[COMMITMENTS_SIZE:COMMITMENTS_SIZE];
  aux2 = in_s[COMMITMENTS_SIZE * 2:COMMITMENTS_SIZE];
  aux3 = in_s[COMMITMENTS_SIZE * 3:COMMITMENTS_SIZE];

  len = COMMITMENTS_SIZE;
  st = A768x4::_absorb_updstate_avx2x4(st, aux0, aux1, aux2, aux3, len);
  st = _finish_updstate_avx2x4(st);

  len = CH_ROUND_SIZE;
  buf0 = out_s[0:CH_ROUND_SIZE];
  buf1 = out_s[CH_ROUND_SIZE:CH_ROUND_SIZE];
  buf2 = out_s[2*CH_ROUND_SIZE:CH_ROUND_SIZE];
  buf3 = out_s[3*CH_ROUND_SIZE:CH_ROUND_SIZE];
  _, buf0, buf1, buf2, buf3 =
    A48x4::_squeeze_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);

  out_s[0:CV_ROUND_SIZE] = buf0;
  out_s[CV_ROUND_SIZE:CV_ROUND_SIZE] = buf1;
  out_s[2*CV_ROUND_SIZE:CV_ROUND_SIZE] = buf2;
  out_s[3*CV_ROUND_SIZE:CV_ROUND_SIZE] = buf3;

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, idx);
  for z = 0 to (CH_ROUND_SIZE * X4_ROUNDS) / 8 {
    t = out_s[:u64 z];
    out.[:u64 idx + z*8] = t;
  }

  return out;
}

/*
 * Hash one input and all messages players traded during one
 * round to compute one commit (times 4).
 */
fn _commit_v_x4(
  #[secret] reg ptr u8[CV_ROUND_SIZE * PNC_N_ROUNDS] out,
  #[secret] reg ptr u8[MZD_SIZE * PNC_N_ROUNDS] inputs,
  #[secret] reg ptr u8[MSGS_FULL_SIZE * PNC_N_ROUNDS] msgs,
  #[public] reg u64 idx
) -> reg ptr u8[CV_ROUND_SIZE * PNC_N_ROUNDS]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 base t;
  inline int z;

  stack u8[MZD_SIZE * X4_ROUNDS] inputs_s;
  stack u8[MSGS_FULL_SIZE * X4_ROUNDS] msgs_s;
  stack u8[CV_ROUND_SIZE * X4_ROUNDS] out_s;

  reg ptr u8[MSGS_FULL_SIZE] aux0, aux1, aux2, aux3;
  reg ptr u8[24] bufI0, bufI1, bufI2, bufI3;
  reg ptr u8[CV_ROUND_SIZE] buf0, buf1, buf2, buf3;

  stack u64[4*25+1] s_st;
  reg ptr u64[4*25+1] st;

  /*****************************/
  /*  EXTRACT INPUTS (NO SLICE)*/
  /*****************************/

  base = idx;
  base *= MZD_SIZE;
  for z = 0 to (MZD_SIZE * X4_ROUNDS) / 8 {
    t = inputs.[:u64 base + z*8];
    inputs_s[:u64 z] = t;
  }

  base = idx;
  base *= MSGS_FULL_SIZE;
  for z = 0 to (MSGS_FULL_SIZE * X4_ROUNDS) / 8 {
    t = msgs.[:u64 base + z*8];
    msgs_s[:u64 z] = t;
  }

  idx *= CV_ROUND_SIZE;
  () = #spill(out, idx);

  /*****************************/
  /*         SET STATE         */
  /*****************************/
  x = (R136 >> 3);
  y = SHAKE;
  st = s_st;
  st = _init_updstate_avx2x4(st, x, y);

  len = 24;
  bufI0 = inputs_s[0:24];
  bufI1 = inputs_s[MZD_SIZE:24];
  bufI2 = inputs_s[2*MZD_SIZE:24];
  bufI3 = inputs_s[3*MZD_SIZE:24];

  st = A24x4::_absorb_updstate_avx2x4(st, bufI0, bufI1, bufI2, bufI3, len);

  aux0 = msgs_s[0: MSGS_FULL_SIZE];
  aux1 = msgs_s[MSGS_FULL_SIZE: MSGS_FULL_SIZE];
  aux2 = msgs_s[2*MSGS_FULL_SIZE: MSGS_FULL_SIZE];
  aux3 = msgs_s[3*MSGS_FULL_SIZE: MSGS_FULL_SIZE];

  len = MSGS_FULL_SIZE;
  st = A1536x4::_absorb_updstate_avx2x4(st, aux0, aux1, aux2, aux3, len);
  st = _finish_updstate_avx2x4(st);

  len = CV_ROUND_SIZE;
  buf0 = out_s[0:CV_ROUND_SIZE];
  buf1 = out_s[CV_ROUND_SIZE:CV_ROUND_SIZE];
  buf2 = out_s[2*CV_ROUND_SIZE:CV_ROUND_SIZE];
  buf3 = out_s[3*CV_ROUND_SIZE:CV_ROUND_SIZE];
  _, buf0, buf1, buf2, buf3 =
    A48x4::_squeeze_updstate_avx2x4(st, buf0, buf1, buf2, buf3, len);
  out_s[0:CV_ROUND_SIZE] = buf0;
  out_s[CV_ROUND_SIZE:CV_ROUND_SIZE] = buf1;
  out_s[2*CV_ROUND_SIZE:CV_ROUND_SIZE] = buf2;
  out_s[3*CV_ROUND_SIZE:CV_ROUND_SIZE] = buf3;

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, idx);
  for z = 0 to (CV_ROUND_SIZE * X4_ROUNDS) / 8 {
    t = out_s[:u64 z];
    out.[:u64 idx + z*8] = t;
  }

  return out;
}
