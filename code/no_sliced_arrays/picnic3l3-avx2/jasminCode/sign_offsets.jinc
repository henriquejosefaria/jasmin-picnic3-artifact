/* Sign path without per-round copies (offset arithmetic), transplanted from the
 * for-loop L3 code so that L3 Sign is implemented like L5 Sign.
 * Functions whose names already exist in this tree are prefixed with fl_. */

require "params.jinc"
require "keccak/keccak1600_updstate.jinc"
require "keccak/keccak1600x4_updstate.jinc"

namespace FL_A1 {
  param int _ASIZE = 1;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}
namespace FL_A1x4 {
  param int _ASIZE = 1;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}
namespace FL_A2 {
  param int _ASIZE = 2;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}
namespace FL_A256x4 {
  param int _ASIZE = TAPE_SIZE_BYTES;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}
namespace FL_A2x4 {
  param int _ASIZE = 2;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}
namespace FL_A32 {
  param int _ASIZE = PNC_SALT_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}
namespace FL_A32x4 {
  param int _ASIZE = PNC_SALT_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}
namespace FL_A64x4 {
  param int _ASIZE = 2 * MAX_SEED_SIZE_BYTES;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}
namespace FL_N_2_PNC_SEED_SIZE {
  param int _ASIZE = 2 * PNC_SEED_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}
namespace FL_N_PNC_SEED_SIZE {
  param int _ASIZE = PNC_SEED_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}
namespace FL_N_TREE_DATA_SIZEx4 {
  param int _ASIZE = TREE_DATA_SIZE;
  require "keccak/keccak1600x4_updstate_ASIZE.jinc"
}

fn _masked_mzd_from_char_array(
	#[poly=data] reg mut ptr u8[MZD_SIZE] result,
	#[poly=data] reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] data,
	#[public] reg u64 pos
) -> reg ptr u8[MZD_SIZE]
{

  reg u64 t;

  inline int z;

  for z=0 to MZD_U64_SIZE-1
  {
    t = data.[u64 pos];
    t = #BSWAP_64(t);
    result[u64 MZD_U64_SIZE - z - 2] = t;

    pos += 8;
  }

	return result;
}

inline fn __fl_masked_mzd_from_char_array(
	#[poly=data] stack u8[MZD_SIZE] result,
	#[poly=data] stack u8[PNC_N_ROUNDS * MZD_SIZE] data,
	#[public] reg u64 pos
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a;
	reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] b;

	a = result;
	b = data;
	a = _masked_mzd_from_char_array(a, b, pos);
	result = a;

	return result;
}

fn __fl_masked_mzd_to_char_array(
	#[poly=data] reg mut ptr u8[PNC_N_ROUNDS * MZD_SIZE] dst,
	#[poly=data] reg ptr u8[MZD_SIZE] data,
	#[poly=data] reg ptr u8[MZD_SIZE] privKey,
	#[public]    reg u64 pos
) -> reg ptr u8[PNC_N_ROUNDS * MZD_SIZE]
{
	reg u64 tmp aux idx;

	dst.[u64 pos + 24] = 0; // set last u64 word to 0

	idx = MZD_SIZE - 16;
	while(idx > 0)
	{
		
		tmp = data.[u64 idx];
		tmp = #BSWAP(tmp);

		aux = MZD_SIZE - 16;
		aux -= idx;
		aux = privKey.[u64 aux];
		
		aux ^= tmp;
		dst.[u64 pos] = aux;

		pos += 8;
		idx -= 8;
	}

	tmp = data.[u64 idx];
	tmp = #BSWAP(tmp);

	aux = MZD_SIZE - 16;
	aux -= idx;
	aux = privKey.[u64 aux];
	
	aux ^= tmp;
	dst.[u64 pos] = aux;

	return dst;
}

inline fn __fl_reg_to_stack_uint64_192(
  #[poly=b] reg ptr u8[MZD_SIZE] a,
  #[poly=b] stack u8[MZD_SIZE] b
) -> stack u8[MZD_SIZE]
{
  reg u256 t;

	t = a[u256 0];
	b[u256 0] = t;

  return b;
}

inline fn __fl_copy3Words_22(
	#[poly=tmp] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] tree, 
	#[poly=tmp] stack u8[4 * 2 * MAX_SEED_SIZE_BYTES] tmp, 
	#[public]   reg u64 idx_1, 
	#[public]   reg u64 idx_2
) -> reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_INPUT_SIZE
	{t = tmp.[u64 idx_2 + z * 8]; tree.[u64 idx_1 + z*8] = t;}

	return tree;
}

inline fn __fl_copy_input_seed2(
	#[poly=iSeedsTree] stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] output, 
	#[poly=iSeedsTree] stack u8[TREE_NODES_1_SIZE] input, 
	#[public]          reg u64 out_idx in_idx
) -> stack u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to PNC_U64_SEED_SIZE
	{
		t = input.[u64 in_idx + z * 8];
		output.[u64 out_idx + z * 8] = t;

	}

	return output;
}

fn _fl_mzd_copy_uint64_192(
	#[poly=y] reg ptr u8[MZD_SIZE] x,
	#[poly=y] reg ptr u8[MZD_SIZE] y
) -> reg ptr u8[MZD_SIZE]
{
	reg u256 t;
	t = y[u256 0];
	x[u256 0] = t;

	return x;
}

inline fn __fl_mzd_copy_uint64_192(
	#[poly=y] stack u8[MZD_SIZE] x,
	#[poly=y] stack u8[MZD_SIZE] y
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a b;

	a = x;
	b = y;
	a = _fl_mzd_copy_uint64_192(a,b);
	x = a;
	
	return x;
}

fn _fl_mzd_xor_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] f_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg u256 t;

	t = f_block_j[u256 0];
	t ^= s_block_j[u256 0];
	r_block_j[u256 0] = t;

	return r_block_j;
}

inline fn __fl_mzd_xor_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _fl_mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

fn _fl_mzd_and_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] f_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t;

	t = f_block_j[u64 0];
	t &= s_block_j[u64 0];
	r_block_j[u64 0] = t;

	t = f_block_j[u64 1];
	t &= s_block_j[u64 1];
	r_block_j[u64 1] = t;

	t = f_block_j[u64 2];
	t &= s_block_j[u64 2];
	r_block_j[u64 2] = t;

	return r_block_j;
}

inline fn __fl_mzd_and_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _fl_mzd_and_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

fn _fl_mzd_shift2_left_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;


	t1  = block[u64 2];
	t2 = block[u64 1];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1  = block[u64 1];
	t2 = block[u64 0];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 0];
	
	t1 = t1 << 2;

	r_block[u64 0] = t1;

	return r_block;
}

inline fn __fl_mzd_shift2_left_uint64_192(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;
	a = _fl_mzd_shift2_left_uint64_192(a,b);
	r_block_j = a;

	return r_block_j;
}

fn _fl_mzd_shift1_left_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[u64 2];
	t2 = block[u64 1];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1  = block[u64 1];
	t2 = block[u64 0];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 0];
	
	t1 = t1 << 1;

	r_block[u64 0] = t1;
	
	return r_block;
}

inline fn __fl_mzd_shift1_left_uint64_192(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;

	a = _fl_mzd_shift1_left_uint64_192(a,b);

	r_block_j = a;

	return r_block_j;
}

fn _fl_mzd_shift2_right_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[u64 0];
	t2 = block[u64 1];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[u64 0] = t1;


	t1  = block[u64 1];
	t2 = block[u64 2];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 2];
	
	t1 = t1 >> 2;

	r_block[u64 2] = t1;

	return r_block;
}

inline fn __fl_mzd_shift2_right_uint64_192(
