	t1  = block[u64 0];
	t2 = block[u64 1];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[u64 0] = t1;


	t1  = block[u64 1];
	t2 = block[u64 2];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 2];
	
	t1 = t1 >> 1;

	r_block[u64 2] = t1;

	return r_block;
}

inline fn __fl_mzd_shift1_right_uint64_192(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
