require "copy.jinc"
require "params.jinc"

/*
 * This function copies MZD_SIZE bytes between two arrays.
 */
fn _mzd_copy_uint64_192(
	#[poly=y] reg ptr u8[MZD_SIZE] x,
	#[poly=y] reg ptr u8[MZD_SIZE] y
) -> reg ptr u8[MZD_SIZE]
{

	reg u256 t;
	t = y[:u256 0];
	x[:u256 0] = t;

	return x;
}

/*
 * This function XORs MZD_SIZE bytes between two arrays.
 */
fn _mzd_xor_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j,
	#[secret] reg ptr u8[MZD_SIZE] f_block_j,
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg u256 t;

	t = f_block_j[:u256 0];
	t ^= s_block_j[:u256 0];
	r_block_j[:u256 0] = t;

	return r_block_j;
}

/*
 * This function ANDs MZD_SIZE bytes between two arrays.
 */
fn _mzd_and_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j,
	#[secret] reg ptr u8[MZD_SIZE] f_block_j,
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t;

	t = f_block_j[:u64 0];
	t &= s_block_j[:u64 0];
	r_block_j[:u64 0] = t;

	t = f_block_j[:u64 1];
	t &= s_block_j[:u64 1];
	r_block_j[:u64 1] = t;

	t = f_block_j[:u64 2];
	t &= s_block_j[:u64 2];
	r_block_j[:u64 2] = t;

	return r_block_j;
}

/*
 * This function shifts an array's MZD_SIZE bytes 2 bits left.
 */
fn _mzd_shift2_left_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;


	t1  = block[:u64 2];
	t2 = block[:u64 1];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[:u64 2] = t1;


	t1  = block[:u64 1];
	t2 = block[:u64 0];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1  = block[:u64 0];
	
	t1 = t1 << 2;

	r_block[:u64 0] = t1;

	return r_block;
}

/*
 * This function shifts an array's MZD_SIZE bytes 1 bit left.
 */
fn _mzd_shift1_left_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[:u64 2];
	t2 = block[:u64 1];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[:u64 2] = t1;


	t1  = block[:u64 1];
	t2 = block[:u64 0];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1  = block[:u64 0];
	
	t1 = t1 << 1;

	r_block[:u64 0] = t1;
	
	return r_block;
}

/*
 * This function shifts an array's MZD_SIZE bytes 2 bits right.
 */
fn _mzd_shift2_right_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[:u64 0];
	t2 = block[:u64 1];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[:u64 0] = t1;


	t1  = block[:u64 1];
	t2 = block[:u64 2];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1  = block[:u64 2];
	
	t1 = t1 >> 2;

	r_block[:u64 2] = t1;

	return r_block;
}

/*
 * This function shifts an array's MZD_SIZE bytes 1 bit right.
 */
fn _mzd_shift1_right_uint64_192(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[:u64 0];
	t2 = block[:u64 1];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[:u64 0] = t1;


	t1  = block[:u64 1];
	t2 = block[:u64 2];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1  = block[:u64 2];
	
	t1 = t1 >> 1;

	r_block[:u64 2] = t1;

	return r_block;
}

/*
 * This function rotates an array 1 u64 word left.
 */
fn __mzd_rotate_left_uint64_192(
	reg ptr u8[MZD_SIZE] r_block,
	reg ptr u8[MZD_SIZE] block,
	reg u64 count
) -> reg ptr u8[MZD_SIZE]
{

	reg u64 t1 t2 right_count tmp;

	right_count = 64;
	right_count -= count;


	t1 = block[:u64 2];
	t2 = block[:u64 1];

	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[:u64 2] = t1;


	t1 = block[:u64 1];
	t2 = block[:u64 0];
	
	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1 = block[:u64 0];
	t2 = block[:u64 2];
	
	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[:u64 0] = t1;

	return r_block;
}

/*
 * This function rotates an array 1 u64 word right.
 */
fn __mzd_rotate_right_uint64_192(
	reg ptr u8[MZD_SIZE] r_block,
	reg ptr u8[MZD_SIZE] block,
	reg u64 count
) -> reg ptr u8[MZD_SIZE]
{

	reg u64 t1 t2 left_count;
	stack u64 s_count s_left_count;

	left_count = 64;
	left_count -= count;
	s_left_count = left_count;
	s_count = count;
	
	t1 = block[:u64 0];
	t2 = block[:u64 1];

	_, _, _, _, _, t1 = #SHR(t1, count);
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[:u64 0] = t1;

	
	t1 = block[:u64 1];
	t2 = block[:u64 2];

	_, _, _, _, _, t1 = #SHR(t1,count);
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[:u64 1] = t1;


	t1 = block[:u64 2];
	t2 = block[:u64 0];

	_, _, _, _, _, t1 = #SHR(t1,count);
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[:u64 2] = t1;
	

	return r_block;
}

