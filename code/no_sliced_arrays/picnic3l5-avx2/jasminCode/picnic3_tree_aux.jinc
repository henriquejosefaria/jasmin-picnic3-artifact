

inline
fn _exists_1(
  #[public] reg ptr u8[TREE_NUM_NODES_1] tree,
  #[public] reg u64 idx,
  #[public] reg u8 t
) -> reg u8
{
  t = 0;
  if(idx < TREE_NUM_NODES_1 - 1)
  {
    t = tree[(int)idx];
  }

  return t;
}

fn __exists_2(
  #[public] reg ptr u8[TREE_NUM_NODES_2] tree,
  #[public] reg u64 idx,
  #[public] reg u8 t
) -> reg u8
{

  t = 0;
  if(idx < TREE_NUM_NODES_2)
  {
    t = tree[(int)idx];
  }

  return t;
}

fn __exists_22(
  #[public] reg ptr u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] tree,
  #[public] reg u64 idx,
  #[public] reg u8 t
) -> reg u8
{

  t = 0;
  if(idx < PNC_N_ROUNDS * TREE_NUM_NODES_2)
  {
    t = tree[idx];
  }

  return t;
}

inline
fn __exists_3(
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree,
  #[public] reg u64 idx,
  #[public] reg u8 t
) -> reg u8
{
  
  t = 0;
  if(idx < TREE_NUM_NODES_3)
  {
    t = tree[(int)idx];
  }

  return t;
}

inline
fn _getParent(#[public] reg u64 node) -> reg u64
{

  if(node != 0){
  	  node += 1;
  	  node >>= 1;
  	  node -= 1;
  }

  return node;	  
}

inline
fn _getParent_u16(#[public] reg u16 node) -> reg u16
{

  if(node != 0){
      node += 1;
      node >>= 1;
      node -= 1;
  }

  return node;    
}

fn __hasRightChild_T1(
  #[public] reg ptr u8[TREE_NUM_NODES_1] tree,
  #[public] reg u64 node
) -> reg u8
{
  reg u8 t8;
  reg u64 t t64;

  t64 = 0;

  t = node;
  t <<= 1;
  t += 2;
  if(t < TREE_NUM_NODES_1)
  {
    t8 = _exists_1(tree, node, t8);
  } 
  else { t8 = 0; }

  t8 = t8;
  return t8;
}

fn __hasRightChild_T2(
  #[public] reg ptr u8[TREE_NUM_NODES_2] tree,
  #[public] reg u64 node
) -> reg u8
{
  reg u8 t8;
  reg u64 t t64;

  t64 = 0;

  t = node;
  t <<= 1;
  t += 2;
  if(t < TREE_NUM_NODES_2)
  {
    t8 = __exists_2(tree, node, t8);
  } 
  else { t8 = 0; }

  t8 = t8;
  return t8;
}

inline
fn _contains(
  #[public] reg ptr u64[REVEALED_SIZE] revealed,
  #[public] reg u64 len,
  #[public] reg u64 value
) -> reg u8
{
  reg u8 res;
  reg u64 i t64;
  
  res = 0;
  i=0;
  while(i < len)
  {
    t64 = revealed[(int)i];
    if(t64 == value) { res = 1; }

    i += 1;
  }
  
  return res;
}

inline
fn _contains_2(
  #[public] stack u64[REVEALED_SIZE_2] revealed,
  #[public] reg u64 len,
  #[public] reg u64 value
) -> reg u8
{
  reg u8 res;
  reg u64 i t64;
  
  res = 0;
  i=0;
  while(i < len)
  {
    t64 = revealed[(int)i];
    if(t64 == value) { res = 1; }

    i += 1;
  }
  
  return res;
}

fn _contains_pathSets(
  #[public] reg ptr u16[PNC_N_ROUNDS * (TREE_DEPTH_1 - 1)] pathSet,
  #[public] reg u64 value,
  #[public] reg u64 offset
) -> reg u8
{
  reg u8 res;
  reg u16 t16;
  reg u64 i t64;
  
  res = 0;
  i=0;
  while(i < PNC_N_OPENED_ROUNDS)
  {
    t16 = pathSet[(int)offset];
    t64 = (64u) t16;
    if(t64 == value) { res = 1; }

    offset += 1;
    i += 1;
  }
  
  return res;
}

inline fn __contains_pathSets(
  #[public] stack u16[PNC_N_ROUNDS * (TREE_DEPTH_1 - 1)] pathSet,
  #[public] reg u64 value,
  #[public] reg u64 offset
) -> reg u8
{
  reg u8 res;
  reg ptr u16[PNC_N_ROUNDS * (TREE_DEPTH_1 - 1)] a;

  a = pathSet;
  res = _contains_pathSets(a, value, offset);

  return res;
}

fn _contains_pathSets_2(
  #[public] reg ptr u16[TREE_DEPTH_2 - 1] pathSet,
  #[public] reg u64 value,
  #[public] reg u64 offset
) -> reg u8
{
  reg u8 res;
  reg u16 t16;
  reg u64 i t64;
  
  res = 0;
  i=0;
  while(i < 1)
  {
    t16 = pathSet[(int)offset];
    t64 = (64u) t16;
    if(t64 == value) { res = 1; }

    offset += 1;
    i += 1;
  }
  
  return res;
}


inline fn __contains_pathSets_2(
  #[public] stack u16[TREE_DEPTH_2 - 1] pathSet,
  #[public] reg u64 value,
  #[public] reg u64 offset
) -> reg u8
{
  reg u8 res;
  reg ptr u16[TREE_DEPTH_2 - 1] a;

  a = pathSet;
  
  res = _contains_pathSets_2(a, value, offset);

  return res;
}


fn __isLeftChild(
  #[public] reg u64 node
) -> reg u8
{
  reg u8 t;
  reg u64 node2;

  node2 = node;
  node2 &= 0x01;

  if(node2 == 1) { t = 1; }
  else { t = 0; }

  return t;
}

fn __hasSibling(
  #[public] reg ptr u8[TREE_NUM_NODES_1] tree,
  #[public] reg u64 s_node
) -> reg u8
{
  reg u8 t8;
  reg u64 node;

  node = s_node;

  t8 = _exists_1(tree, node, t8);
  
  if(t8 == 1)
  {
    t8 = __isLeftChild(node);

    if(t8 == 1)
    {
      node += 1;
      t8 = _exists_1(tree, node, t8);
      if(t8 == 0)
      {
        t8 = 0;
      } 
      else
      {
        t8 = 1;
      }
    }
    else
    {
      t8 = 1;
    } 
  }
  else
  {
    t8 = 0;
  }

  return t8;
}

fn __hasSibling_2(
  #[public] reg ptr u8[TREE_NUM_NODES_2] tree,
  #[public] reg u64 s_node
) -> reg u8
{
  reg u8 t8;
  reg u64 node;

  node = s_node;

  t8 = __exists_2(tree, node, t8);
  
  if(t8 == 1)
  {
    t8 = __isLeftChild(node);

    if(t8 == 1)
    {
      node += 1;
      t8 = __exists_2(tree, node, t8);
      if(t8 == 0)
      {
        t8 = 0;
      } 
      else
      {
        t8 = 1;
      }
    }
    else
    {
      t8 = 1;
    } 
  }
  else
  {
    t8 = 0;
  }

  return t8;
}
