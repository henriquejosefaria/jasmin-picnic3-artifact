inline fn __computeParentHash(
  #[secret] stack u8[TREE_NODES_3_SIZE] tree,
  #[public] stack u8[TREE_NUM_NODES_3] tree_have,
  #[public] stack u8[TREE_NUM_NODES_3] tree_exists,
  #[public] reg u64 child,
  #[secret] stack u8[PNC_SALT_SIZE] salt
) -> stack u8[TREE_NODES_3_SIZE], stack u8[TREE_NUM_NODES_3], stack u8[TREE_NUM_NODES_3]
{
  reg u8 t8;
  reg u16 parent_u16;
  reg u64 parent child_aux t;

  stack u64 s_parent;

  reg ptr u8[TREE_NODES_3_SIZE] reg_tree;
  reg ptr u8[TREE_NUM_NODES_3] reg_tree_have;
  reg ptr u8[TREE_NUM_NODES_3] reg_tree_exists;
  reg ptr u8[PNC_SALT_SIZE] reg_salt;

  t = child;
  reg_tree_exists = tree_exists;
  t8 = __exists_3(reg_tree_exists, t, t8);


  if(t8 == 1)
  {
    parent = child; // update parent register
    parent = _getParent(parent); 
    t8 = tree_have[(int)parent];

    s_parent = parent;

    if(t8 == 0)
    {
      child_aux = parent;
      child_aux <<= 1;
      child_aux += 1;

      /* Compute the hash for parent, if we have everything */
      t8 = tree_have[(int)child_aux];

      if(t8 == 1)
      {

        child_aux += 1;
        t = child_aux;
        reg_tree_exists = tree_exists;
        t8 = __exists_3(reg_tree_exists, t, t8);

        if(t8 == 1){

          t8 = tree_have[(int)child_aux];

          if(t8 == 0){
            t = 0;
          }else{ t = 1; }
        } else{ t = 1; }

        if(t == 1) // If that node was not yet computed
        {
          /* Compute parent data = H(left child data || [right child data] || salt || parent idx) */

          reg_salt   = salt;
          parent_u16 = parent;
          reg_tree   = tree;
          reg_tree_have = tree_have;
          reg_tree_exists = tree_exists;
          reg_tree, reg_tree_have, reg_tree_exists = 
            _computeParentHash(reg_tree, reg_tree_have, reg_tree_exists, reg_salt, parent, parent_u16);
          tree_exists = reg_tree_exists;
          tree_have = reg_tree_have;
          tree = reg_tree;

        }
      }
    }
  }

  return tree, tree_have, tree_exists;
}

fn _getRevealedMerkleNodes(
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_exists,
  #[public] reg ptr u16[MISSING_LEAVES_SIZE] missingLeaves,
  #[public] reg ptr u64[REVEALED_SIZE] revealed
) -> reg ptr u64[REVEALED_SIZE], reg u64
{
  reg u8 t8;
  reg u16 t16 node;
  reg u64 lastNonLeaf pos i t64 aux;

  stack u8[TREE_NUM_NODES_3] missingNodes;

  /* Mark leaves that are missing */

  i = 0;
  while(i < TREE_NUM_NODES_3)
  {
    missingNodes[(int)i] = 0;

    i += 1;
  }
  
  i = 0;
  while(i < MISSING_LEAVES_SIZE)
  {
    t16 = missingLeaves[(int)i];
    t64 = (64u)t16;
    missingNodes[ (TREE_NUM_NODES_3 - TREE_NUM_LEAVES_3) + (int)t64] = 1;

    i += 1;
  }
  

  /* For the nonleaf nodes, if both leaves are missing, mark it as missing too */
  
  lastNonLeaf = TREE_NUM_NODES_3 - 1;
  lastNonLeaf = _getParent(lastNonLeaf);
  while(lastNonLeaf > 0)
  {
    t64 = lastNonLeaf;
    t8 = __exists_3(tree_exists, t64, t8);
    if(t8 == 1)
    {
      t64 <<= 1;
      t64 += 2;
      t8 = __exists_3(tree_exists, t64, t8);
      if(t8 == 1)
      {

        // if (missingNodes[2 * i + 1] && missingNodes[2 * i + 2])

        t8 = missingNodes[(int)t64];
        if(t8 == 1)
        {
          t64 -= 1;
          t8 = missingNodes[(int)t64];
          if(t8 == 1)
          {
            missingNodes[(int)lastNonLeaf] = 1;
          }

        }
      }
      else
      {
        t64 -= 1;
        t8 = missingNodes[(int)t64];
        if(t8 == 1)
        {
          missingNodes[(int)lastNonLeaf] = 1;
        }
      }
    } 

    lastNonLeaf -= 1;
  }


  /* For each missing leaf node, add the highest missing node on the path
    * back to the root to the set to be revealed */
   
   pos = 0;
   i = 0;
   while(i < MISSING_LEAVES_SIZE)
   {
      
    node = missingLeaves[(int)i];
    node += TREE_NUM_NODES_3 - TREE_NUM_LEAVES_3;
    
    t64 = (64u) node;
    aux = (64u) node;
      while(t64 != 0)
      {
        t64 = _getParent(t64);
        t8 = missingNodes[(int)t64];
        
        if(t8 == 0)
        {

          t8 = _contains(revealed, pos, aux);
        
          if(t8 == 0)
          {
            revealed[(int)pos] = aux;
            pos += 1;
          }
        

          t64 = 0;
        }

        aux = t64;
      }
      
      i += 1;
   }
   
   return revealed, pos;
}

inline fn __getRevealedMerkleNodes(
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_exists,
  #[public] reg ptr u16[MISSING_LEAVES_SIZE] missingLeaves,
  #[public] stack u64[REVEALED_SIZE] revealed
) -> stack u64[REVEALED_SIZE], reg u64
{
  reg u64 res;
  reg ptr u64[REVEALED_SIZE] a;

  a = revealed;
  a, res = _getRevealedMerkleNodes(tree_exists, missingLeaves, a);
  revealed = a;

  return revealed, res;
}

inline
fn __openMerkleTreeSize(
  #[public] stack u8[TREE_NUM_NODES_3] tree_exists,
  #[public] stack u16[MISSING_LEAVES_SIZE] missingLeaves
) -> reg u64
{
  reg u64 revealedSize;
  stack u64[REVEALED_SIZE] revealed;

  reg ptr u8[TREE_NUM_NODES_3] a;
  reg ptr u16[MISSING_LEAVES_SIZE] b;

  a = tree_exists;
  b = missingLeaves;
  revealed, revealedSize = __getRevealedMerkleNodes( a, b, revealed);

  revealedSize *= PNC_DIGEST_SIZE;

  return revealedSize;

}

#[returnadress="stack"]
fn __isNotNull(
  reg ptr u8[CV_FULL_SIZE] cv,
  reg u64 idx
) -> reg u64
{
  reg u8 t8;
  reg u64 result i pos;

  result = 0;

  pos = idx;
  pos *= CV_ROUND_SIZE;

  i = 0;
  while(i < CV_ROUND_SIZE)
  {
    t8 = cv[(int)pos];

    if(t8 != 0)
    {
      result = 1;
      i = CV_ROUND_SIZE;
    }

    pos += 1;
    i += 1;
  }

  return result;
}



