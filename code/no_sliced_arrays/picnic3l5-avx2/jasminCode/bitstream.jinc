	start_bits = 8;
	start_bits -= skip_bits;

	aux = 1;
	tmp = start_bits;
	_, _, _, _, _, aux = #SHL(aux, tmp);
	aux -= 1;
	ret &= aux;

	if(start_bits < num_bits){ /* start_bits < num_bits */

	  num_bits -= start_bits;
	  aux = position;
	  aux >>= 3;
	  aux += 1;

	  while(num_bits >= 8) /* num_bits >= 8 */
	  {
	  	p = bs[aux];
	  	ret1 = (64u) p;
	  	ret <<= 8;
	  	ret |= ret1;
	    
	  	num_bits -= 8;
	  	aux += 1;	
	  }

	  if (num_bits > 0) { /* num_bits > 0 */
	  	tmp = num_bits;
	  	_, _, _, _, _, ret = #SHL(ret, tmp);

	  	p = bs[aux];
	  	ret1 = (64u) p;
	  	tmp = 8;
	  	tmp -= num_bits;
	  	_, _, _, _, _, ret1 = #SHR(ret1, tmp); 
	  	aux = 1;
	  	tmp = num_bits;
	  	_, _, _, _, _, aux = #SHL(aux, tmp);
	  	aux -= 1;
	  	ret1 &= aux;

	  	ret |= ret1;

	  }

	}
	else{
		tmp = start_bits;
		tmp -= num_bits; 
		_, _, _, _, _, ret = #SHR(ret, tmp);
	}

  return ret;
}


fn _mzd_from_bitstream_msgs(
	#[secret] reg ptr u8[MSGS_FULL_SIZE] bs,
	#[secret] reg ptr u8[MZD_SIZE] v,
	#[public] reg u64 pos
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 bits out_pos t num_bits;

	bits = LOWMC_N_BITS;
	out_pos = (MZD_U64_SIZE - 1);

	while(bits >= 64)
	{
		num_bits = 64;
		t = _bitstream_get_bits2(bs, pos, num_bits);
		v[u64 out_pos] = t;

		out_pos -= 1;
		bits -= 64;
		pos += 64;
	}

	if(bits > 0)
	{
		num_bits = bits;
		t = _bitstream_get_bits2(bs, pos, num_bits);
		num_bits = 64;
		num_bits -= bits;
		_, _, _, _, _, t = #SHL(t,num_bits);
		v[u64 out_pos] = t;

		out_pos -= 1;
	}

	return v;
}

inline fn __mzd_from_bitstream_msgs(
	#[secret] reg ptr u8[MSGS_FULL_SIZE] bs,
	#[secret] stack u8[MZD_SIZE] v,
	#[public] reg u64 pos
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a;

	a = v;
	a = _mzd_from_bitstream_msgs(bs, a, pos);
	v = a;

	return v;
}

