		out_pos -= 1;
		bits -= 64;
		pos += 64;
	}

	if(bits > 0)
	{
		num_bits = bits;
		t = _bitstream_get_bits_msgs(bs, pos, num_bits);
		num_bits = 64;
		num_bits -= bits;
		_, _, _, _, _, t = #SHL(t,num_bits);
		v[u64 out_pos] = t;

		out_pos -= 1;
	}

	return v;
}

