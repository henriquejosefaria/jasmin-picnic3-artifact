fn _mzd_from_bitstream_msgs2(
	#[secret] reg ptr u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] bs,
	#[secret] reg ptr u8[MZD_SIZE] v,
	#[public] reg u64 pos
) -> reg ptr u8[MZD_SIZE]
