require "params.jinc"
require "copy.jinc"


fn _mzd_copy_uint64_256(
	#[poly=y] reg ptr u8[MZD_SIZE] x,
	#[poly=y] reg ptr u8[MZD_SIZE] y
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t;

	inline int z;

	for z=0 to MZD_U64_SIZE
	{ t = y.[u64 z*8]; x.[u64 z*8] = t; }
	
	return x;
}


inline fn __mzd_copy_uint64_256(
	#[poly=y] stack u8[MZD_SIZE] x,
	#[poly=y] stack u8[MZD_SIZE] y
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a b;

	a = x;
	b = y;
	a = _mzd_copy_uint64_256(a,b);
	x = a;
	
	return x;
}

inline fn __mzd_copy_uint64_256_v1(
	#[poly=y] stack u8[MZD_SIZE] x,
	#[poly=y] stack u8[MZD_SIZE] y
) -> stack u8[MZD_SIZE]
{

	reg u64 t;

	inline int z;

	for z=0 to MZD_U64_SIZE
	{ t = y[u64 z]; t = #BSWAP_64(t); x[u64 MZD_U64_SIZE-1-z] = t; }
	
	return x;
}


fn _mzd_xor_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] f_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	#[mmy] reg u256 ymm0;

	ymm0 = f_block_j[u256 0];
	ymm0 ^= s_block_j[u256 0];
	r_block_j[u256 0] = ymm0;

	return r_block_j;
}

inline fn __mzd_xor_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

inline fn __mzd_xor_uint64_block_v2(
	#[poly=r_block_j] reg ptr u8[MZD_SIZE] r_block_j, 
	#[poly=f_block_j] stack u8[MZD_SIZE] f_block_j, 
	#[poly=s_block_j] stack u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

inline fn __mzd_xor_uint64_block_v3(
	#[poly=r_block_j] stack u8[MZD_SIZE] r_block_j, 
	#[poly=f_block_j] stack u8[MZD_SIZE] f_block_j, 
	#[poly=s_block_j] reg ptr u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_xor_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

fn _mzd_and_uint64_block(
	#[secret] reg ptr u8[MZD_SIZE] r_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] f_block_j, 
	#[secret] reg ptr u8[MZD_SIZE] s_block_j
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t;

	t = f_block_j[u64 0];
	t &= s_block_j[u64 0];
	r_block_j[u64 0] = t;

	t = f_block_j[u64 1];
	t &= s_block_j[u64 1];
	r_block_j[u64 1] = t;

	t = f_block_j[u64 2];
	t &= s_block_j[u64 2];
	r_block_j[u64 2] = t;

	t = f_block_j[u64 3];
	t &= s_block_j[u64 3];
	r_block_j[u64 3] = t;

	return r_block_j;
}

inline fn __mzd_and_uint64_block(
	#[secret] stack u8[MZD_SIZE] r_block_j, 
	#[secret] stack u8[MZD_SIZE] f_block_j, 
	#[secret] stack u8[MZD_SIZE] s_block_j
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b,c;

	a = r_block_j;
	b = f_block_j;
	c = s_block_j; 

	a = _mzd_and_uint64_block(a,b,c);

	r_block_j = a;

	return r_block_j;
}

fn _mzd_shift2_left_uint64_256(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;


	t1  = block[u64 3];
	t2 = block[u64 2];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[u64 3] = t1;


	t1  = block[u64 2];
	t2 = block[u64 1];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1  = block[u64 1];
	t2 = block[u64 0];

	t1 = t1 << 2;
	t2 = t2 >> 62;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 0];
	
	t1 = t1 << 2;

	r_block[u64 0] = t1;

	return r_block;
}

inline fn __mzd_shift2_left_uint64_256(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;
	a = _mzd_shift2_left_uint64_256(a,b);
	r_block_j = a;

	return r_block_j;
}

fn _mzd_shift1_left_uint64_256(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[u64 3];
	t2 = block[u64 2];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[u64 3] = t1;


	t1  = block[u64 2];
	t2 = block[u64 1];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1  = block[u64 1];
	t2 = block[u64 0];

	t1 = t1 << 1;
	t2 = t2 >> 63;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 0];
	
	t1 = t1 << 1;

	r_block[u64 0] = t1;
	
	return r_block;
}

inline fn __mzd_shift1_left_uint64_256(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;

	a = _mzd_shift1_left_uint64_256(a,b);

	r_block_j = a;

	return r_block_j;
}

fn _mzd_shift2_right_uint64_256(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;


	t1  = block[u64 0];
	t2 = block[u64 1];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[u64 0] = t1;


	t1  = block[u64 1];
	t2 = block[u64 2];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 2];
	t2 = block[u64 3];

	t1 = t1 >> 2;
	t2 = t2 << 62;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1 = block[u64 3];
	
	t1 >>= 2;

	r_block[u64 3] = t1;

	return r_block;
}

inline fn __mzd_shift2_right_uint64_256(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;

	a = _mzd_shift2_right_uint64_256(a,b);

	r_block_j = a;

	return r_block_j;
}

fn _mzd_shift1_right_uint64_256(
	#[poly=block] reg ptr u8[MZD_SIZE] r_block,
	#[poly=block] reg ptr u8[MZD_SIZE] block
) -> reg ptr u8[MZD_SIZE]
{
	reg u64 t1 t2;

	t1  = block[u64 0];
	t2 = block[u64 1];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[u64 0] = t1;


	t1  = block[u64 1];
	t2 = block[u64 2];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[u64 1] = t1;


	t1  = block[u64 2];
	t2 = block[u64 3];

	t1 = t1 >> 1;
	t2 = t2 << 63;
	t1 |= t2;

	r_block[u64 2] = t1;


	t1  = block[u64 3];

	t1 = t1 >> 1;

	r_block[u64 3] = t1;


	return r_block;
}

inline fn __mzd_shift1_right_uint64_256(
	#[poly=block] stack u8[MZD_SIZE] r_block_j, 
	#[poly=block] stack u8[MZD_SIZE] block
) -> stack u8[MZD_SIZE]
{
	reg ptr u8[MZD_SIZE] a,b;

	a = r_block_j;
	b = block;

	a = _mzd_shift1_right_uint64_256(a,b);

	r_block_j = a;

	return r_block_j;
}

fn __mzd_rotate_left_uint64_256(
	reg ptr u8[MZD_SIZE] r_block,
	reg ptr u8[MZD_SIZE] block,
	reg u64 count
) -> reg ptr u8[MZD_SIZE]
{

	reg u64 t1 t2 right_count tmp;

	right_count = 64;
	right_count -= count;


  	t1 = block[u64 3];
	t2 = block[u64 2];

	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[u64 3] = t1;


	t1 = block[u64 2];
	t2 = block[u64 1];

	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[u64 2] = t1;


	t1 = block[u64 1];
	t2 = block[u64 0];
	
	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[u64 1] = t1;


	t1 = block[u64 0];
	t2 = block[u64 3];
	
	tmp = count;
	_, _, _, _, _, t1 = #SHL(t1, tmp);
	tmp = right_count;
	_, _, _, _, _, t2 = #SHR(t2, tmp);
	t1 |= t2;

	r_block[u64 0] = t1;

	return r_block;
}

fn __mzd_rotate_right_uint64_256(
	reg ptr u8[MZD_SIZE] r_block,
	reg ptr u8[MZD_SIZE] block,
	reg u64 count
) -> reg ptr u8[MZD_SIZE]
{

	reg u64 t1 t2 left_count tmp;

	left_count = 64;
	left_count -= count;


	t1 = block[u64 0];
	t2 = block[u64 1];

	tmp = count;
	_, _, _, _, _, t1 = #SHR(t1,count);
	tmp = left_count;
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[u64 0] = t1;

	
	t1 = block[u64 1];
	t2 = block[u64 2];

	tmp = count;
	_, _, _, _, _, t1 = #SHR(t1,count);
	tmp = left_count;
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[u64 1] = t1;


	t1 = block[u64 2];
	t2 = block[u64 3];

	tmp = count;
	_, _, _, _, _, t1 = #SHR(t1,count);
	tmp = left_count;
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[u64 2] = t1;

	t1 = block[u64 3];
	t2 = block[u64 0];

	tmp = count;
	_, _, _, _, _, t1 = #SHR(t1,count);
	tmp = left_count;
	_, _, _, _, _, t2 = #SHL(t2, left_count);
	t1 |= t2;

	r_block[u64 3] = t1;
	

	return r_block;
}

