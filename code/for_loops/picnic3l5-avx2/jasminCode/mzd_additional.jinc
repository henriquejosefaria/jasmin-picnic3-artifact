fn _mzd_addmul_v_uint64_256(
	#[secret] reg ptr u8[MZD_SIZE] c_block vptr,
	#[secret] reg ptr u64[MATRIX_ROUND] a_block
) -> reg ptr u8[MZD_SIZE]
{

	reg u64 i1 i2 v mask base_matrix;
	#[mmx] reg u128 xmm0 xmm1 xmm4 xmm5;
	#[mmy] reg u256 ymm0 ymm1 ymm2 ymm3;

	
	ymm2 = c_block[u256 0];
	ymm3 = #set0_256();

	i1 = 0;
	base_matrix = 0;
	while(i1 < MZD_SIZE)
	{
		v = vptr.[u64 i1];
		i2 = 0;
		while(i2 < 64)
		{
			mask = v;
			base_matrix += 128;
			mask &= 1;
			_, _, _, _, _, mask = #NEG_64(mask);

			xmm0 = (128u) mask;
			mask = v;
			_, _, _, _, _, mask = #SAL(mask,62);
			ymm0 = #VPBROADCAST_4u64(xmm0);
			ymm0 &= a_block.[u256 base_matrix - 128];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm1 = (128u) mask;
			mask = v;
			ymm2 ^= ymm0;
			_, _, _, _, _, mask = #SAL(mask,61);
			ymm1 = #VPBROADCAST_4u64(xmm1);
			ymm1 &= a_block.[u256 base_matrix - 96];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm4 = (128u) mask;
			mask = v;
			v >>= 4;
			_, _, _, _, _, mask = #SAL(mask,60);
			ymm0 = #VPBROADCAST_4u64(xmm4);
			ymm0 &= a_block.[u256 base_matrix - 64];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm5 = (128u) mask;
			ymm2 ^= ymm0;
			ymm0 = #VPBROADCAST_4u64(xmm5);
			ymm0 &= a_block.[u256 base_matrix - 32];
			ymm0 ^= ymm1;
			ymm3 ^= ymm0;
	
			i2 += 4;
		}
	
		i1 += 8;
	}

	ymm3 ^= ymm2;
	c_block[u256 0] = ymm3;

	return c_block;
}

inline fn __mzd_addmul_v_uint64_256(
	#[secret] stack u8[MZD_SIZE] c_block vptr,
	#[secret] stack u64[MATRIX_ROUND] a_block
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a b;
	reg ptr u64[MATRIX_ROUND] c;
	
	a = c_block;
	b = vptr;
	c = a_block;

	a = _mzd_addmul_v_uint64_256(a,b,c);

	c_block = a;

	return c_block;
}


inline fn __mzd_addmul_v_uint64_256_v2(
	stack u8[MZD_SIZE] c_block,
	reg ptr u8[MZD_SIZE] vptr,
	stack u64[MATRIX_ROUND] a_block
) -> stack u8[MZD_SIZE]
{

	reg ptr u8[MZD_SIZE] a;
	reg ptr u64[MATRIX_ROUND] c;
	
	a = c_block;
	c = a_block;

	a = _mzd_addmul_v_uint64_256(a,vptr,c);
	c_block = a;

	return c_block;
}

fn _mzd_addmul_v_uint64_256_v2(
	#[secret] reg u256 ymm2,
	#[secret] reg ptr u8[MZD_SIZE] vptr,
	#[secret] reg ptr u64[MATRIX_ROUND] a_block
) -> reg u256
{

	reg u64 i1 i2 v mask base_matrix;
	#[mmx] reg u128 xmm0 xmm1 xmm4 xmm5;
	#[mmy] reg u256 ymm0 ymm1 ymm3;

	ymm3 = #set0_256();

	i1 = 0;
	base_matrix = 0;
	while(i1 < MZD_SIZE)
	{
		v = vptr.[u64 i1];
		i2 = 0;
		while(i2 < 64)
		{
			mask = v;
			base_matrix += 128;
			mask &= 1;
			_, _, _, _, _, mask = #NEG_64(mask);

			xmm0 = (128u) mask;
			mask = v;
			_, _, _, _, _, mask = #SAL(mask,62);
			ymm0 = #VPBROADCAST_4u64(xmm0);
			ymm0 &= a_block.[u256 base_matrix - 128];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm1 = (128u) mask;
			mask = v;
			ymm2 ^= ymm0;
			_, _, _, _, _, mask = #SAL(mask,61);
			ymm1 = #VPBROADCAST_4u64(xmm1);
			ymm1 &= a_block.[u256 base_matrix - 96];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm4 = (128u) mask;
			mask = v;
			v >>= 4;
			_, _, _, _, _, mask = #SAL(mask,60);
			ymm0 = #VPBROADCAST_4u64(xmm4);
			ymm0 &= a_block.[u256 base_matrix - 64];
			_, _, _, _, _, mask = #SAR(mask,63);

			xmm5 = (128u) mask;
			ymm2 ^= ymm0;
			ymm0 = #VPBROADCAST_4u64(xmm5);
			ymm0 &= a_block.[u256 base_matrix - 32];
			ymm0 ^= ymm1;
			ymm3 ^= ymm0;
	
			i2 += 4;
		}
	
		i1 += 8;
	}

	ymm2 ^= ymm3;
	
	return ymm2;
}

inline fn __mzd_addmul_v_uint64_256_v3(
	reg u256 c_block,
	reg ptr u8[MZD_SIZE] vptr,
	stack u64[MATRIX_ROUND] a_block
) -> reg u256
{

	reg ptr u64[MATRIX_ROUND] c;
	
	c = a_block;

	c_block = _mzd_addmul_v_uint64_256_v2(c_block,vptr,c);

	return c_block;
}

inline fn __mzd_mul_v_uint64_256(
	#[secret] stack u8[MZD_SIZE] c_block,
	#[secret] stack u8[MZD_SIZE] vptr,
	#[secret] stack u64[MATRIX_ROUND] k_matrix_
) -> stack u8[MZD_SIZE]
{
	reg u256 t;

	reg ptr u8[MZD_SIZE] a b;
	reg ptr u64[MATRIX_ROUND] c;

	a = c_block;
	b = vptr;
	c = k_matrix_;

	t = #set0_256();
	a[u256 0] = t;

	a = _mzd_addmul_v_uint64_256(a,b,c);

	c_block = a;

	return c_block;
}





















