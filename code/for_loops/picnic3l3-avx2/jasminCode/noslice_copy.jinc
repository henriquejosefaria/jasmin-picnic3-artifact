/* Slice-free copy helpers (no_sliced_arrays PICNIC3L3).
 * Replace sub-arrays taken at a run-time offset (big[off : SMALL]) by an explicit
 * copy between the big array and a fixed-size buffer. off is a BYTE offset.
 *   __ns_get_X / __ns_put_X   : stack arrays (no pointer registers needed)
 *   __ns_getp_X / __ns_putp_X : reg ptr big array (for non-inline callers)  */

require "params.jinc"

inline fn __ns_get_tapes(
  stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] big,
  stack u8[TAPES_FULL_SIZE] small,
  reg u64 off
) -> stack u8[TAPES_FULL_SIZE]
{
  reg u64 i j t;
  i = 0;
  while(i < TAPES_FULL_SIZE) {
    j = off; j += i;
    t = big.[:u64 j];
    small.[:u64 i] = t;
    i += 8;
  }
  return small;
}

inline fn __ns_put_tapes(
  stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] big,
  stack u8[TAPES_FULL_SIZE] small,
  reg u64 off
) -> stack u8[PNC_N_ROUNDS * TAPES_FULL_SIZE]
{
  reg u64 i j t;
  i = 0;
  while(i < TAPES_FULL_SIZE) {
    t = small.[:u64 i];
    j = off; j += i;
    big.[:u64 j] = t;
    i += 8;
  }
  return big;
}

inline fn __ns_getp_tapes(
  reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] big,
  stack u8[TAPES_FULL_SIZE] small,
  reg u64 off
) -> stack u8[TAPES_FULL_SIZE]
{
  reg u64 i j t;
  i = 0;
  while(i < TAPES_FULL_SIZE) {
    j = off; j += i;
    t = big.[:u64 j];
    small.[:u64 i] = t;
    i += 8;
  }
  return small;
}

inline fn __ns_putp_tapes(
  reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] big,
  stack u8[TAPES_FULL_SIZE] small,
  reg u64 off
) -> reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE]
{
  reg u64 i j t;
  i = 0;
  while(i < TAPES_FULL_SIZE) {
    t = small.[:u64 i];
    j = off; j += i;
    big.[:u64 j] = t;
    i += 8;
  }
  return big;
}

