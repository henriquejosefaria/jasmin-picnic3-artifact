inline fn __ns_get_flags2(
  stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] big,
  stack u8[TREE_NUM_NODES_2] small,
  reg u64 off
) -> stack u8[TREE_NUM_NODES_2]
{
  reg u64 i j t;
  reg u8 b;
  i = 0;
  while(i < 24) {
    j = off; j += i;
    t = big.[:u64 j];
    small.[:u64 i] = t;
    i += 8;
  }
  while(i < TREE_NUM_NODES_2) {
    j = off; j += i;
    b = big[j];
    small[i] = b;
    i += 1;
  }
  return small;
}

inline fn __ns_put_flags2(
  stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] big,
  stack u8[TREE_NUM_NODES_2] small,
  reg u64 off
) -> stack u8[PNC_N_ROUNDS * TREE_NUM_NODES_2]
{
  reg u64 i j t;
  reg u8 b;
  i = 0;
  while(i < 24) {
    t = small.[:u64 i];
    j = off; j += i;
    big.[:u64 j] = t;
    i += 8;
  }
  while(i < TREE_NUM_NODES_2) {
    b = small[i];
    j = off; j += i;
    big[j] = b;
    i += 1;
  }
  return big;
}

inline fn __ns_getp_flags2(
  reg ptr u8[PNC_N_ROUNDS * TREE_NUM_NODES_2] big,
  stack u8[TREE_NUM_NODES_2] small,
  reg u64 off
) -> stack u8[TREE_NUM_NODES_2]
{
  reg u64 i j t;
  reg u8 b;
  i = 0;
  while(i < 24) {
    j = off; j += i;
    t = big.[:u64 j];
    small.[:u64 i] = t;
    i += 8;
  }
  while(i < TREE_NUM_NODES_2) {
    j = off; j += i;
