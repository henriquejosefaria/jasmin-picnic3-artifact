require "params.jinc"
require "noslice_copy.jinc"
require "common/subreadwrite_imem.jinc"
require "keccak/keccak1600_updstate.jinc"

namespace A1 {
  param int _ASIZE = 1;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A2 {
  param int _ASIZE = 2;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A13 {
  param int _ASIZE = PNC_MESSAGE_BYTE_LENGTH;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A24 {
  param int _ASIZE = PNC_INPUT_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A32 {
  param int _ASIZE = PNC_SALT_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A48 {
  param int _ASIZE = 2*PNC_INPUT_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A56 {
  param int _ASIZE = PNC_SALT_AND_ROOT_LENGTH;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A96 {
  param int _ASIZE = TAPE_AUX_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A768 {
  param int _ASIZE = COMMITMENTS_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A1536 {
  param int _ASIZE = MSGS_FULL_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}

namespace A20112 {
  param int _ASIZE = PNC_N_ROUNDS * CH_ROUND_SIZE;
  require "keccak/keccak1600_updstate_ASIZE.jinc"
}


/**************************/
/*     HASH FUNCTIONS     */
/**************************/

#[returnaddress="stack"]
fn _computeSaltAndRootSeed(
  #[secret]          reg ptr u8[PNC_SALT_AND_ROOT_LENGTH] out,
  #[poly=privateKey] reg ptr u8[MZD_SIZE] privateKey,
  #[poly=publickey]  reg ptr u8[MZD_SIZE] publicKey,
  #[poly=plaintext]  reg ptr u8[MZD_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message
) -> reg ptr u8[PNC_SALT_AND_ROOT_LENGTH]
{
  
  reg ui64 len;
  reg u16 t16;
  reg ui8 x;
  reg u8 y;

  stack u8[2] t16_s;

  reg ptr u8[2] t16_r;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, privateKey, publicKey, plaintext, message);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  t16 = LOWMC_N_BITS;
  t16_s[:u16 0] = t16;

  len = 24;
  () = #unspill(privateKey);
  pst = A24::_update_updstate_avx2(pst, privateKey[0:24], len);
  len = 13;
  () = #unspill(message);
  pst = A13::_update_updstate_avx2(pst,          message, len);
  len = 24;
  () = #unspill(publicKey);
  pst = A24::_update_updstate_avx2(pst,  publicKey[0:24], len);
  len = 24;
  () = #unspill(plaintext);
  pst = A24::_update_updstate_avx2(pst,  plaintext[0:24], len);
  len = 2;
  t16_r = t16_s;
  pst = A2::_update_updstate_avx2(pst,  t16_r, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 56;
  () = #unspill(out);
  _, out = A56::_squeeze_updstate_avx2(pst, out, len);

  return out;
}

#[returnaddress="stack"]
fn _hashSeed_1(
  #[secret]         reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] out,
  #[poly=inputSeed] reg ptr u8[TREE_NODES_1_SIZE] inputSeed,
  #[poly=salt]      reg ptr u8[PNC_SALT_SIZE] salt,
  #[public]         reg u64 inputSeed_idx,
  #[poly=repIndex]  reg u16 repIndex,
  #[poly=nodeIndex] reg u16 nodeIndex
) -> reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 t;
  inline int z;

  stack u8[1] prefix_s;
  stack u8[2] t16_s;
  stack u8[PNC_SEED_SIZE] seed_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16;
  reg ptr u8[PNC_SEED_SIZE] seed;
  reg ptr u8[2 * PNC_SEED_SIZE] reg_out;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out);
  () = #spill(salt);
  () = #spill(repIndex);
  () = #spill(nodeIndex);

  /*****************************/
  /*  EXTRACT SEED (NO SLICE)  */
  /*****************************/

  for z = 0 to PNC_SEED_SIZE / 8 {
    t = inputSeed.[:u64 inputSeed_idx + z*8];
    seed_s[:u64 z] = t;
  }

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;

  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  prefix_s[0] = HASH_PREFIX_1;
  prefix = prefix_s;
  len = 1;
  pst = A1::_update_updstate_avx2(pst, prefix, len);

  len = 24;
  seed = seed_s;
  pst = A24::_update_updstate_avx2(pst, seed, len);

  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(repIndex);
  t16_s[:u16 0] = repIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  
  len = 2;
  () = #unspill(nodeIndex);
  t16_s[:u16 0] = nodeIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  () = #unspill(out);
  reg_out = out[0:2 * PNC_SEED_SIZE];
  _, reg_out = A48::_squeeze_updstate_avx2(pst, reg_out, len);
  out[0:2 * PNC_SEED_SIZE] = reg_out;

  return out;
}

#[returnaddress="stack"]
fn _hashSeed_2(
  #[secret]         reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES] out,
  #[poly=inputSeed] reg ptr u8[TREE_NODES_2_SIZE] inputSeed,
  #[poly=salt]      reg ptr u8[PNC_SALT_SIZE] salt,
  #[public]         reg u64 inputSeed_idx,
  #[poly=repIndex]  reg u16 repIndex,
  #[poly=nodeIndex] reg u16 nodeIndex
) -> reg ptr u8[4 * 2 * MAX_SEED_SIZE_BYTES]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 t;
  inline int z;

  stack u8[1] prefix_s;
  stack u8[2] t16_s;
  stack u8[PNC_SEED_SIZE] seed_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16;
  reg ptr u8[PNC_SEED_SIZE] seed;
  reg ptr u8[2 * PNC_SEED_SIZE] reg_out;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, repIndex, nodeIndex);

  /*****************************/
  /*  EXTRACT SEED (NO SLICE)  */
  /*****************************/

  for z = 0 to PNC_SEED_SIZE / 8 {
    t = inputSeed.[:u64 inputSeed_idx + z*8];
    seed_s[:u64 z] = t;
  }

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/


  len = 1;
  prefix_s[0] = HASH_PREFIX_1;
  prefix = prefix_s;
  pst = A1::_update_updstate_avx2(pst, prefix, len);
  len = 24;
  seed = seed_s;
  pst = A24::_update_updstate_avx2(pst, seed, len);
  len = 32;
  pst = A32::_update_updstate_avx2(pst, salt, len);
 
  len = 2;
  () = #unspill(repIndex);
  t16_s[:u16 0] = repIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  
  len = 2;
  () = #unspill(nodeIndex);
  t16_s[:u16 0] = nodeIndex;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  () = #unspill(out);
  reg_out = out[0:2 * PNC_SEED_SIZE];
  _, reg_out = A48::_squeeze_updstate_avx2(pst, reg_out, len);
  out[0:2 * PNC_SEED_SIZE] = reg_out;

  return out;
}

#[returnaddress="stack"]
fn _commit(
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] out,
  #[secret] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 round16;
  reg u64 idx0 idx1 t;
  inline int z;

  stack u8[2] t16_s;
  stack u8[TREE_DATA_SIZE] seed_s;
  stack u8[TAPE_AUX_SIZE] tape_aux_s;
  stack u8[COMMITMENT_SIZE] output_s;

  reg ptr u8[2] t16;
  reg ptr u8[TREE_DATA_SIZE] seed;
  reg ptr u8[TAPE_AUX_SIZE] tape_aux;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, tapes, salt, round, player);

  /*****************************/
  /*  EXTRACT SEED (NO SLICE)  */
  /*****************************/

  idx0 = round;
  idx0 *= TREE_NODES_2_SIZE;
  idx1 = (64u) player;
  idx0 += GET_LEAVES_2 * PNC_INPUT_SIZE;
  idx1 *= PNC_INPUT_SIZE;
  idx0 += idx1;
  for z = 0 to TREE_DATA_SIZE / 8 {
    t = seeds.[:u64 idx0 + z*8];
    seed_s[:u64 z] = t;
  }

  /*******************************/
  /* EXTRACT TAPE_AUX (NO SLICE) */
  /*******************************/

  () = #unspill(tapes, round);
  idx0 = round;
  idx0 *= TAPES_FULL_SIZE;
  idx0 += TAPE_AUX_IDX;
  for z = 0 to TAPE_AUX_SIZE / 8 {
    t = tapes.[:u64 idx0 + z*8];
    tape_aux_s[:u64 z] = t;
  }

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 24;
  seed = seed_s;
  pst = A24::_update_updstate_avx2(pst, seed, len);
  len = 96;
  tape_aux = tape_aux_s;
  pst = A96::_update_updstate_avx2(pst, tape_aux, len);
  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(round);
  round16 = round;
  t16_s[:u16 0] = round16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);

  len = 2;
  () = #unspill(player);
  t16_s[:u16 0] = player;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round, player);
  idx1 = round;
  idx1 *= COMMITMENTS_SIZE;
  idx0 = (64u) player;
  idx0 *= COMMITMENT_SIZE;
  idx1 += idx0;
  for z = 0 to COMMITMENT_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx1 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _commit_verify(
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] out,
  #[secret] reg ptr u8[TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[TAPES_FULL_SIZE] tapes,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 round16;
  reg u64 idx0 idx1 t;
  inline int z;

  stack u8[2] t16_s;
  stack u8[TREE_DATA_SIZE] seed_s;
  stack u8[TAPE_AUX_SIZE] tape_aux_s;
  stack u8[COMMITMENT_SIZE] output_s;

  reg ptr u8[2] t16;
  reg ptr u8[TREE_DATA_SIZE] seed;
  reg ptr u8[TAPE_AUX_SIZE] tape_aux;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, salt, round, player);

  /*****************************/
  /*  EXTRACT SEED (NO SLICE)  */
  /*****************************/

  idx1 = (64u) player;
  idx1 += GET_LEAVES_2;
  idx1 *= TREE_DATA_SIZE;
  for z = 0 to TREE_DATA_SIZE / 8 {
    t = seeds.[:u64 idx1 + z*8];
    seed_s[:u64 z] = t;
  }

  /*******************************/
  /* EXTRACT TAPE_AUX (NO SLICE) */
  /*******************************/

  idx0 = TAPE_AUX_IDX;
  for z = 0 to TAPE_AUX_SIZE / 8 {
    t = tapes.[:u64 idx0 + z*8];
    tape_aux_s[:u64 z] = t;
  }

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 24;
  seed = seed_s;
  pst = A24::_update_updstate_avx2(pst, seed, len);
  len = 96;
  tape_aux = tape_aux_s;
  pst = A96::_update_updstate_avx2(pst, tape_aux, len);
  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(round);
  round16 = round;
  t16_s[:u16 0] = round16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);

  len = 2;
  () = #unspill(player);
  t16_s[:u16 0] = player;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round, player);
  idx1 = round;
  idx1 *= COMMITMENTS_SIZE;
  idx0 = (64u) player;
  idx0 *= COMMITMENT_SIZE;
  idx1 += idx0;
  for z = 0 to COMMITMENT_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx1 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _commit_verify_v2(
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] out,
  #[secret] reg ptr u8[TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[PROOFS_FULL_SIZE] proofs,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u64 proof_round,
  #[public] reg u16 player
) -> reg ptr u8[COMMITMENTS_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 round16;
  reg u64 idx0 idx1 t;
  inline int z;

  stack u8[2] t16_s;
  stack u8[TREE_DATA_SIZE] seed_s;
  stack u8[TAPE_AUX_SIZE] tape_aux_s;
  stack u8[COMMITMENT_SIZE] output_s;

  reg ptr u8[2] t16;
  reg ptr u8[TREE_DATA_SIZE] seed;
  reg ptr u8[TAPE_AUX_SIZE] tape_aux;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, salt, round, player);

  /*****************************/
  /*  EXTRACT SEED (NO SLICE)  */
  /*****************************/

  idx1 = (64u) player;
  idx1 += GET_LEAVES_2;
  idx1 *= TREE_DATA_SIZE;
  for z = 0 to TREE_DATA_SIZE / 8 {
    t = seeds.[:u64 idx1 + z*8];
    seed_s[:u64 z] = t;
  }

  /*******************************/
  /* EXTRACT TAPE_AUX (NO SLICE) */
  /*******************************/

  idx0 = proof_round;
  idx0 *= PROOF_FULL_SIZE;
  idx0 += PROOF_AUX_IDX;
  for z = 0 to TAPE_AUX_SIZE / 8 {
    t = proofs.[:u64 idx0 + z*8];
    tape_aux_s[:u64 z] = t;
  }

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 24;
  seed = seed_s;
  pst = A24::_update_updstate_avx2(pst, seed, len);
  len = 96;
  tape_aux = tape_aux_s;
  pst = A96::_update_updstate_avx2(pst, tape_aux, len);
  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(round);
  round16 = round;
  t16_s[:u16 0] = round16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);

  len = 2;
  () = #unspill(player);
  t16_s[:u16 0] = player;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round, player);
  idx1 = round;
  idx1 *= COMMITMENTS_SIZE;
  idx0 = (64u) player;
  idx0 *= COMMITMENT_SIZE;
  idx1 += idx0;
  for z = 0 to COMMITMENT_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx1 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _commit_assemble(
  #[public] reg u64 out,
  #[secret] reg ptr u8[PNC_N_ROUNDS * TREE_NODES_2_SIZE] seeds,
  #[secret] reg ptr u8[PNC_N_ROUNDS * TAPES_FULL_SIZE] tapes,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 round,
  #[public] reg u16 player
) -> reg u64
{
  reg ui64 len, outi;
  reg ui8 x;
  reg u8 y;
  reg u16 round16;
  reg u64 t offset;

  stack u8[2] t16_s;

  reg ptr u8[2] t16;

  reg ptr u8[TREE_DATA_SIZE] seed;
  reg ptr u8[TAPE_AUX_SIZE] tape_aux;

  stack u8[TREE_DATA_SIZE] tmp_seed;
  stack u8[TAPE_AUX_SIZE] tmp_tape_aux;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(out, seeds, tapes, salt, round, player);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  () = #unspill(round, player, seeds);
  t = round;
  t *= TREE_NODES_2_SIZE;
  offset = (64u)player;
  offset += GET_LEAVES_2;
  offset *= TREE_DATA_SIZE;
  offset += t;
  tmp_seed = __ns_getp_seed2(seeds, tmp_seed, offset);
  seed = tmp_seed;
  
  len = 24;
  pst = A24::_update_updstate_avx2(pst, seed, len);

  if(player == (PNC_N_MPC_PARTIES - 1))
  {
    () = #unspill(round, tapes);
    offset = round;
    offset *= TAPES_FULL_SIZE;
    offset += TAPE_AUX_IDX;
    tmp_tape_aux = __ns_getp_tapeaux(tapes, tmp_tape_aux, offset);
    tape_aux = tmp_tape_aux;
    len = 96;
    pst = A96::_update_updstate_avx2(pst, tape_aux, len);
  }

  () = #unspill(salt);

  len = 32;
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(round);
  round16 = round;
  t16_s[:u16 0] = round16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);

  len = 2;
  () = #unspill(player);
  t16_s[:u16 0] = player;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  () = #unspill(out);
  outi = (64ui)out;
  outi, _ = _squeeze_m_updstate_avx2(outi, len, pst);
  out = (64u)outi;

  return out;
}

#[returnaddress="stack"]
fn _commit_h(
  #[secret] reg ptr u8[CH_FULL_SIZE] out,
  #[secret] reg ptr u8[COMMITMENTS_FULL_SIZE] in,
  #[public] reg u64 round
) -> reg ptr u8[CH_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 idx0 idx1 t;
  inline int z;

  stack u8[COMMITMENTS_SIZE] in_s;
  stack u8[CH_ROUND_SIZE] output_s;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  /*********************************/
  /* EXTRACT COMMITMENTS (NO SLICE) */
  /*********************************/

  idx1 = round;
  idx1 *= COMMITMENTS_SIZE;
  for z = 0 to COMMITMENTS_SIZE / 8 {
    t = in.[:u64 idx1 + z*8];
    in_s[:u64 z] = t;
  }

  () = #spill(out, round);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 768;
  pst = A768::_update_updstate_avx2(pst, in_s, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round);
  idx0 = round;
  idx0 *= CH_ROUND_SIZE;
  for z = 0 to CH_ROUND_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx0 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _commit_v(
  #[secret] reg ptr u8[CV_FULL_SIZE] out,
  #[secret] reg ptr u8[PNC_N_ROUNDS * MZD_SIZE] in1,
  #[secret] reg const ptr u8[PNC_N_ROUNDS * MSGS_FULL_SIZE] in2,
  #[public] reg u64 round
) -> reg ptr u8[CV_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 idx0 idx1 t;
  inline int z;

  stack u8[MZD_SIZE] inputs_s;
  stack u8[MSGS_FULL_SIZE] msgs_s;
  stack u8[CV_ROUND_SIZE] output_s;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  /*****************************/
  /*  EXTRACT INPUTS (NO SLICE)*/
  /*****************************/

  idx0 = round;
  idx0 *= MZD_SIZE;
  for z = 0 to MZD_SIZE / 8 {
    t = in1.[:u64 idx0 + z*8];
    inputs_s[:u64 z] = t;
  }

  idx1 = round;
  idx1 *= MSGS_FULL_SIZE;
  for z = 0 to MSGS_FULL_SIZE / 8 {
    t = in2.[:u64 idx1 + z*8];
    msgs_s[:u64 z] = t;
  }

  () = #spill(out, round);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  y = SHAKE;
  x = (R136 >> 3);
  pst = s_pst;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 24;
  pst = A24::_update_updstate_avx2(pst, inputs_s[0:24], len);
  len = 1536;
  pst = A1536::_update_updstate_avx2(pst, msgs_s, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, round);
  idx0 = round;
  idx0 *= CV_ROUND_SIZE;
  for z = 0 to CV_ROUND_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx0 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _commit_v_verify(
  #[secret] reg ptr u8[CV_FULL_SIZE] out,
  #[secret] reg ptr u8[SIG_PROOFS_SIZE] input,
  #[secret] reg const ptr u8[MSGS_FULL_SIZE] msgs,
  #[public] reg u64 output_idx,
  #[public] reg u64 input_idx
) -> reg ptr u8[CV_FULL_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u64 idx0 t;
  inline int z;

  stack u8[MZD_SIZE] inputs_s;
  stack u8[CV_ROUND_SIZE] output_s;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  /*****************************/
  /*  EXTRACT INPUT (NO SLICE) */
  /*****************************/

  idx0 = input_idx;
  idx0 *= PROOF_FULL_SIZE;
  idx0 += PROOF_INPUT_IDX;
  for z = 0 to MZD_SIZE / 8 {
    t = input.[:u64 idx0 + z*8];
    inputs_s[:u64 z] = t;
  }

  () = #spill(out, output_idx);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  y = SHAKE;
  x = (R136 >> 3);
  pst = s_pst;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  len = 24;
  pst = A24::_update_updstate_avx2(pst, inputs_s[0:24], len);
  len = 1536;
  pst = A1536::_update_updstate_avx2(pst, msgs, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  len = 48;
  _, output_s = A48::_squeeze_updstate_avx2(pst, output_s, len);

  /*****************************/
  /*  WRITE BACK (NO SLICE)    */
  /*****************************/

  () = #unspill(out, output_idx);
  idx0 = output_idx;
  idx0 *= CV_ROUND_SIZE;
  for z = 0 to CV_ROUND_SIZE / 8 {
    t = output_s[:u64 z];
    out.[:u64 idx0 + z*8] = t;
  }

  return out;
}

#[returnaddress="stack"]
fn _computeParentHash(
  #[secret] reg ptr u8[TREE_NODES_3_SIZE] tree,
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_have,
  #[public] reg ptr u8[TREE_NUM_NODES_3] tree_exists,
  #[secret] reg ptr u8[PNC_SALT_SIZE] salt,
  #[public] reg u64 parent,
  #[public] reg u16 parent_u16
) -> reg ptr u8[TREE_NODES_3_SIZE], reg ptr u8[TREE_NUM_NODES_3], reg ptr u8[TREE_NUM_NODES_3]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 t8 y;
  reg u64 child_idx offset;

  stack u8[1] prefix_s;
  stack u8[2] t16_s;

  reg ptr u8[1] prefix;
  reg ptr u8[2] t16;

  reg ptr u8[48] seed;
  reg ptr u8[PNC_DIGEST_SIZE] parent_node;

  stack u8[PNC_DIGEST_SIZE] tmp_node;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  () = #spill(tree, tree_have, tree_exists, salt, parent, parent_u16);
  /*****************************/
  /*         SET STATE         */
  /*****************************/

  pst = s_pst;
  x = (R136 >> 3);
  y = SHAKE;
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/

  prefix_s[0] = HASH_PREFIX_3;
  prefix = prefix_s;
  len = 1;
  pst = A1::_update_updstate_avx2(pst, prefix, len);

  () = #unspill(tree, parent);
  child_idx = parent;
  child_idx <<= 1;
  child_idx *= PNC_DIGEST_SIZE;
  child_idx += PNC_DIGEST_SIZE;

  tmp_node = __ns_getp_node3(tree, tmp_node, child_idx);
  seed = tmp_node;

  len = 48;
  pst = A48::_update_updstate_avx2(pst, seed, len);

  () = #unspill(parent);
  child_idx = parent;
  child_idx <<= 1;
  child_idx += 2;
  t8 = 0;
  if(child_idx < TREE_NUM_NODES_3)
  {

    () = #unspill(tree, parent, tree_exists);
    t8 = tree_exists[parent];
    if(t8 == 1)
    {
      child_idx *= PNC_DIGEST_SIZE;
      tmp_node = __ns_getp_node3(tree, tmp_node, child_idx);
      seed = tmp_node;

      len = 48;
      pst = A48::_update_updstate_avx2(pst, seed, len);
    }
  }

  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);

  len = 2;
  () = #unspill(parent_u16);
  t16_s[:u16 0] =  parent_u16;
  t16 = t16_s;
  pst = A2::_update_updstate_avx2(pst, t16, len);
  pst = _finish_updstate_avx2(pst);

  /*******************************************/
  /* APPLY PERMUTATION TO STATE AND RETRIEVE */
  /*******************************************/

  () = #unspill(parent);
  () = #unspill(tree_have);
  tree_have[parent] = 1;

  parent *= PNC_DIGEST_SIZE;

  len = 48;
  offset = 0;
  parent_node = tmp_node;   /* squeeze writes all 48 bytes: no copy-in needed */
  () = #spill(parent);
  _, parent_node = A48::_squeeze_updstate_avx2(pst, parent_node, len);
  tmp_node = parent_node;
  () = #unspill(tree, parent);
  tree = __ns_putp_node3(tree, tmp_node, parent);

  return tree, tree_have, tree_exists;
}

fn __get_u16(
  #[poly=array] reg ptr u8[PNC_DIGEST_SIZE] array,
  #[public]     reg u64 bits
) -> reg u16
{
  reg u64 byte;
  reg u16 chosen_byte;

  // t = array[bitNumber / 8];

  byte = bits;
  byte >>= 3;
  chosen_byte = array.[:u16 byte];


  // t1 = (7 - (bitNumber % 8)));

  byte = bits;
  byte &= 7;
  bits = 7;
  bits -= byte;


  // t >>= t1;

  while(bits > 0)
  {chosen_byte >>= 1; bits -= 1;}

  // t &= 0x01;

  chosen_byte &= 0x01;

  return chosen_byte;
}

fn _bitsToChunks(
  #[public]      reg u64 chunkLenBits,
  #[poly=chunks] reg ptr u8[PNC_DIGEST_SIZE] input,
  #[poly=chunks] reg ptr u16[CHUNKS_SIZE] chunks
) -> reg u64, reg ptr u16[CHUNKS_SIZE]
{

  reg u16 t16;
  reg u64 i j z t chunkCount;

  if(chunkLenBits > PNC_DIGEST_SIZE * 8)
  {
    chunkCount = 0;
  } 
  else
  {
    chunkCount = (PNC_DIGEST_SIZE * 8);
    chunkCount = chunkCount / chunkLenBits;

    i = 0;
    while(i < chunkCount){
      chunks[i] = 0;
      j = 0;
      while(j < chunkLenBits)
      {
        t = chunkLenBits;
        t *= i;
        t += j;
        t >>= 3;

        t = chunkLenBits;
        t *= i;
        t += j;

        t16 = __get_u16(input, t);

        z = j;
        while(z > 0){t16 <<= 1; z -= 1;}

        t16 += chunks[i];

        chunks[i] = t16;
        j += 1;
      }

      i += 1;
    }
  }

  return chunkCount, chunks;
}

inline fn __bitsToChunks(
  #[public]      reg u64 chunkLenBits,
  #[poly=chunks] stack u8[PNC_DIGEST_SIZE] input,
  #[poly=chunks] stack u16[CHUNKS_SIZE] chunks
) -> reg u64, stack u16[CHUNKS_SIZE]
{
  reg u64 chunkCount;
  reg ptr u8[PNC_DIGEST_SIZE] a;
  reg ptr u16[CHUNKS_SIZE] b;
  
  a = input;
  b = chunks;
  chunkCount, b = _bitsToChunks(chunkLenBits, a, b);
  chunks = b;

  return chunkCount, chunks;
}

/*
 * This function generates challenge values that are public (challengeC and challengeP) 
 *  as such, their values may use #declassify
 */
fn __appendUnique(
  #[public]          reg u16 value,
  #[public]          reg u64 position,
  #[public] reg ptr u8[CHALLENGE_C_SIZE] challengeC
) -> reg u64, reg ptr u8[CHALLENGE_C_SIZE]
{
  reg u16 t;
  reg u64 i tmp64;

  if(position == 0)
  {
    tmp64 = position;
    challengeC[:u16 tmp64] = value;
    position += 1;
  }
  else
  {
    i = 0;
    while(i < position)
    {
      tmp64 = i;
      /* It is a public value - will be within the signature */
      t = challengeC[:u16 tmp64];

      if(t == value){
        i = position;
      }
      i += 1;
    }
    if(i == position){
      tmp64 = position;
      challengeC[:u16 tmp64] = value;
      position += 1;
    }
  }

  return position, challengeC;
}

fn _expand_challenge(
  #[public] reg u64 signature,
  #[public] reg ptr u8[SIG_CHALLENGE_C_SIZE] challengeC,
  #[public] reg ptr u8[SIG_CHALLENGE_P_SIZE] challengeP
) -> reg ptr u8[SIG_CHALLENGE_C_SIZE], reg ptr u8[SIG_CHALLENGE_P_SIZE]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;
  reg u16 t16;
  reg u64 i t64 countC countP;
  reg u64 numChunks bitsPerChunk tmp64;

  stack u64 s_countC s_countP s_bitsPerChunk;

  stack u8[1] prefix_s;
  stack u8[PNC_DIGEST_SIZE] h;
  stack u16[CHUNKS_SIZE] chunks;

  reg ptr u8[1] prefix;
  reg ptr u8[PNC_DIGEST_SIZE] reg_h;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  inline int z;

  for z=0 to PNC_U64_DIGEST_SIZE
  {
    i = [signature + z*8];
    h[:u64 z] = i;
  }

  () = #spill(signature, challengeC, challengeP);

  // Populate C
  // NOTE:  THE ORIGINAL USES U32 WORDS, HERE WERE USING U64 SO
  // THE OPERATION 32 - clz(x - 1) WAS SHIFTED TO 64 - clz(x - 1)

  countC = 0;
  while(countC < CHUNKS_SIZE)
  {
    chunks[countC] = 0;

    countC += 1;
  }

  // bitsPerChunkC
  bitsPerChunk = PNC_N_ROUNDS;
  _, _, _, _, bitsPerChunk = #DEC(bitsPerChunk);
  _, _, _, _, _, bitsPerChunk = #LZCNT_64(bitsPerChunk);
  t64 = bitsPerChunk;
  bitsPerChunk = 64;
  bitsPerChunk -= t64;
  
  s_bitsPerChunk = bitsPerChunk;

  // ORIGINAL
  countC = 0;
  while(countC < PNC_N_OPENED_ROUNDS)
  {
    bitsPerChunk = s_bitsPerChunk;
    numChunks, chunks = __bitsToChunks(bitsPerChunk, h, chunks);

    i = 0;
    while(i < numChunks)
    {
      /* It is a public value within the signature */
      #[declassify] t16 = chunks[i];
      if(t16 < PNC_N_ROUNDS)
      {
        () = #unspill(challengeC);
        countC, challengeC = 
          __appendUnique(t16, countC, challengeC);
        () = #spill(challengeC);
      }
      if(countC == PNC_N_OPENED_ROUNDS)
      {
        i = numChunks;
      }

      i += 1;
    }
    s_countC = countC;
 
    /*****************************/
    /*         SET STATE         */
    /*****************************/

    pst = s_pst;
    x = (R136 >> 3);
    y = SHAKE;
    pst = _init_updstate_avx2(pst, x, y);

    /*****************************/
    /*     ABSORB INTO STATE     */
    /*****************************/
    len = 1;
    prefix_s[:u8 0] = HASH_PREFIX_1;
    prefix = prefix_s;
    pst = A1::_update_updstate_avx2(pst, prefix, len);
    len = 48;
    reg_h = h;
    pst = A48::_update_updstate_avx2(pst, reg_h, len);
    pst = _finish_updstate_avx2(pst);

    len = 48;
    reg_h = h;
    pst, reg_h = A48::_squeeze_updstate_avx2(pst, reg_h, len);
    s_pst = pst;
    h = reg_h;

    countC = s_countC;
  }

  // Note that we always compute h = H(h) after setting C
  
  // bitsPerChunkP
  bitsPerChunk = PNC_N_MPC_PARTIES;
  _, _, _, _, bitsPerChunk = #DEC(bitsPerChunk);
  _, _, _, _, _, bitsPerChunk = #LZCNT_64(bitsPerChunk);
  t64 = bitsPerChunk;
  bitsPerChunk = 64;
  bitsPerChunk -= t64;
  
  s_bitsPerChunk = bitsPerChunk;

  countP = 0;
  while(countP < PNC_N_OPENED_ROUNDS)
  {
    bitsPerChunk = s_bitsPerChunk;
    numChunks, chunks = __bitsToChunks(bitsPerChunk, h, chunks);

    i = 0;
    while(i < numChunks)
    {
      /* It is a public value within the signature */
      #[declassify] t16 = chunks[i];

      if(t16 < PNC_N_MPC_PARTIES)
      {
        tmp64 = countP;
        () = #unspill(challengeP);
        challengeP[:u16 tmp64] = t16;
        () = #spill(challengeP);
        countP += 1;
      }
      if(countP == PNC_N_OPENED_ROUNDS)
      {
        i = numChunks;
      }

      i += 1;
    }
    s_countP = countP;

    if(countP < PNC_N_OPENED_ROUNDS)
    {
      /*****************************/
      /*         SET STATE         */
      /*****************************/

      pst = s_pst;
      x = (R136 >> 3);
      y = SHAKE;
      pst = _init_updstate_avx2(pst, x, y);

      /*****************************/
      /*     ABSORB INTO STATE     */
      /*****************************/
      
      prefix_s[:u8 0] = HASH_PREFIX_1;
      len = 1;
      prefix = prefix_s;
      pst = A1::_update_updstate_avx2(pst, prefix, len);
      len = 48;
      reg_h = h;
      pst = A48::_update_updstate_avx2(pst, reg_h, len);
      pst = _finish_updstate_avx2(pst);

      len = 48;
      reg_h = h;
      pst, reg_h = A48::_squeeze_updstate_avx2(pst, reg_h, len);
      s_pst = pst;
      h = reg_h;

    }
    countP = s_countP;
  }

  () = #unspill(challengeC, challengeP);
  return challengeC, challengeP;
}

inline
fn __expand_challenge(
  #[public] reg u64 sig,
  #[public] stack u8[SIG_CHALLENGE_C_SIZE] challengeC,
  #[public] stack u8[SIG_CHALLENGE_P_SIZE] challengeP
) -> stack u8[SIG_CHALLENGE_C_SIZE], stack u8[SIG_CHALLENGE_P_SIZE]
{

  reg ptr u8[CHALLENGE_C_SIZE] reg_challengeC;
  reg ptr u8[CHALLENGE_P_SIZE] reg_challengeP;

  reg_challengeC = challengeC;
  reg_challengeP = challengeP;
  reg_challengeC, reg_challengeP = _expand_challenge(sig, reg_challengeC, reg_challengeP);
  challengeC = reg_challengeC;
  challengeP = reg_challengeP;

  return challengeC, challengeP;
}

#[returnaddress="stack"]
fn _HCP_base(
  #[poly=chalenge_h] reg ptr u8[CH_FULL_SIZE] challenge_h,
  #[poly=treeCv]     reg ptr u8[PNC_DIGEST_SIZE] treeCv,
  #[poly=salt]       reg ptr u8[PNC_SALT_SIZE] salt,
  #[poly=pubKey]     reg ptr u8[PNC_INPUT_SIZE] pubKey,
  #[poly=plaintext]  reg ptr u8[PNC_INPUT_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message,
  #[public]          reg mut ptr u64[26] pst
) -> reg ptr u64[26]
{
  reg ui64 len;
  reg ui8 x;
  reg u8 y;

  () = #spill(salt);
  () = #spill(pubKey);
  () = #spill(treeCv);
  () = #spill(message);
  () = #spill(plaintext);

  /*****************************/
  /*         SET STATE         */
  /*****************************/

  y = SHAKE;
  x = (R136 >> 3);
  pst = _init_updstate_avx2(pst, x, y);

  /*****************************/
  /*     ABSORB INTO STATE     */
  /*****************************/
  
  len = 20112;
  pst = A20112::_update_updstate_avx2(pst, challenge_h, len);
  len = 48;
  () = #unspill(treeCv);
  pst = A48::_update_updstate_avx2(pst, treeCv[0:PNC_DIGEST_SIZE], len);
  len = 32;
  () = #unspill(salt);
  pst = A32::_update_updstate_avx2(pst, salt, len);
  len = 24;
  () = #unspill(pubKey);
  pst = A24::_update_updstate_avx2(pst, pubKey, len);
  len = 24;
  () = #unspill(plaintext);
  pst = A24::_update_updstate_avx2(pst, plaintext, len);
  len = 13;
  () = #unspill(message);
  pst = A13::_update_updstate_avx2(pst, message, len);
  pst = _finish_updstate_avx2(pst);

  return pst;
}

/*
 * Compute the challenge.
 */
#[returnaddress="stack"]
fn _HCP(
  #[public]          reg u64 signature,
  #[poly=chalenge_h] reg ptr u8[CH_FULL_SIZE] challenge_h,
  #[poly=treeCv]     reg ptr u8[TREE_NODES_3_SIZE] treeCv,
  #[poly=salt]       reg ptr u8[PNC_SALT_SIZE] salt,
  #[poly=pubKey]     reg ptr u8[MZD_SIZE] pubKey,
  #[poly=plaintext]  reg ptr u8[MZD_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message,
  #[public]          reg ptr u8[SIG_CHALLENGE_C_SIZE] challengeC,
  #[public]          reg ptr u8[SIG_CHALLENGE_P_SIZE] challengeP
) -> reg u64, reg ptr u8[SIG_CHALLENGE_C_SIZE], reg ptr u8[SIG_CHALLENGE_P_SIZE]
{
  reg ui64 len out;
  reg u64 t;
  inline int z;

  stack u8[PNC_DIGEST_SIZE] treeCv_s;
  stack u8[PNC_INPUT_SIZE] pubKey_s;
  stack u8[PNC_INPUT_SIZE] plaintext_s;

  reg ptr u8[PNC_DIGEST_SIZE] reg_treeCv;
  reg ptr u8[PNC_INPUT_SIZE] reg_pubKey;
  reg ptr u8[PNC_INPUT_SIZE] reg_plaintext;

  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  /*******************************/
  /*  EXTRACT INPUTS (NO SLICE)  */
  /*******************************/

  for z = 0 to PNC_DIGEST_SIZE / 8 {
    t = treeCv.[:u64 z*8];
    treeCv_s[:u64 z] = t;
  }
  for z = 0 to PNC_INPUT_SIZE / 8 {
    t = pubKey.[:u64 z*8];
    pubKey_s[:u64 z] = t;
  }
  for z = 0 to PNC_INPUT_SIZE / 8 {
    t = plaintext.[:u64 z*8];
    plaintext_s[:u64 z] = t;
  }

  () = #spill(signature);
  () = #spill(challengeC);
  () = #spill(challengeP);

  pst = s_pst;
  reg_treeCv = treeCv_s;
  reg_pubKey = pubKey_s;
  reg_plaintext = plaintext_s;
  pst = _HCP_base(challenge_h, reg_treeCv, salt, reg_pubKey, reg_plaintext, message, pst);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/
  len = 48;
  () = #unspill(signature);
  out = (64ui)signature;
  _, _ = _squeeze_m_updstate_avx2(out, len, pst);
  s_pst = pst;

  () = #unspill(signature, challengeC, challengeP);
  challengeC, challengeP = _expand_challenge(signature, challengeC, challengeP);

  () = #unspill(signature);
  signature += SIG_CHALLENGE_SIZE;
  return signature, challengeC, challengeP;
}

#[returnaddress="stack"]
fn _HCP_verify(
  #[public]          reg ptr u8[SIG_CHALLENGE_SIZE] challenge,
  #[poly=chalenge_h] reg ptr u8[CH_FULL_SIZE] challenge_h,
  #[poly=treeCv]     reg ptr u8[PNC_DIGEST_SIZE] treeCv,
  #[poly=salt]       reg ptr u8[PNC_SALT_SIZE] salt,
  #[poly=pubKey]     reg ptr u8[MZD_SIZE] pubKey,
  #[poly=plaintext]  reg ptr u8[MZD_SIZE] plaintext,
  #[poly=message]    reg ptr u8[PNC_MESSAGE_BYTE_LENGTH] message
) -> reg ptr u8[SIG_CHALLENGE_SIZE]
{
  reg ui64 len;
  stack u64[26] s_pst;
  reg ptr u64[26] pst;

  reg ptr u8[PNC_INPUT_SIZE] a b;

  pst = s_pst;
  () = #spill(challenge);
  a = pubKey[0:PNC_INPUT_SIZE];
  b = plaintext[0:PNC_INPUT_SIZE];
  pst = _HCP_base(challenge_h, treeCv, salt, a, b, message, pst);

  /***********************/
  /* RETRIEVE FROM STATE */
  /***********************/

  len = 48;
  () = #unspill(challenge);
  _, challenge = A48::_squeeze_updstate_avx2(pst, challenge, len);

  return challenge;
}

