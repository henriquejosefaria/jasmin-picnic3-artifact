    var b:W8.t Array96.t;
    var a:W8.t Array192.t;
    var r:W64.t;
    var round16:W16.t;
    var player16:W16.t;
    var round_idx:int;
    var base:int;
    var offset:int;
    a <- witness;
    b <- witness;
    c <- witness;
    c <- salt;
    round_idx <- round;
    base <- player;
    base <- (base * 24);
